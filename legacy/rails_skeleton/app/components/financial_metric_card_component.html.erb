<%# app/components/financial_metric_card_component.html.erb %>
<div class="relative overflow-hidden rounded-2xl bg-slate-900/80 backdrop-blur-xl p-6 border border-slate-800/80 shadow-2xl transition-all duration-300 hover:border-slate-700 hover:shadow-indigo-500/5 group"
     data-controller="financial-metric"
     data-financial-metric-target-value-value="<%= @amount %>">
  
  <%# Subtle gradient glow %>
  <div class="absolute -top-24 -right-24 w-48 h-48 bg-<%= @accent_color %>-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-<%= @accent_color %>-500/20 transition-all duration-500"></div>

  <div class="flex items-center justify-between text-slate-400">
    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400"><%= @title %></span>
    <div class="p-2.5 rounded-xl border <%= icon_color_classes %> shadow-inner">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <% case @icon %>
        <% when "wallet" %>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
        <% when "trending-up" %>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
        <% when "shield-check" %>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        <% when "safe" %>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        <% else %>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        <% end %>
      </svg>
    </div>
  </div>

  <div class="mt-4 flex items-baseline gap-2">
    <div class="text-3xl font-extrabold tracking-tight text-white font-mono" data-financial-metric-target="value">
      <%= formatted_amount %>
    </div>
    
    <% if @change_percent %>
      <span class="inline-flex items-center text-xs font-semibold px-2.5 py-0.5 rounded-full <%= badge_classes %>">
        <%= @trend == :up ? '+' : '' %><%= @change_percent %>%
      </span>
    <% end %>
  </div>

  <% if @subtitle %>
    <p class="mt-2 text-xs text-slate-400 font-medium">
      <%= @subtitle %>
    </p>
  <% end %>
</div>

