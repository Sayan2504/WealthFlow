<%# app/components/policy_card_component.html.erb %>
<div class="rounded-2xl bg-slate-900/80 backdrop-blur-xl p-5 border border-slate-800 hover:border-slate-700 transition-all shadow-xl group">
  <div class="flex items-start justify-between">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full uppercase tracking-wider <%= category_badge_classes %>">
          <%= @policy.category.upcase %> • <%= @policy.policy_type.titleize %>
        </span>
        <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= status_badge_classes %>">
          <%= @policy.active? ? "Active" : "Expired" %>
        </span>
      </div>
      <h4 class="text-base font-bold text-white group-hover:text-indigo-300 transition-colors">
        <%= @policy.provider_name %>
      </h4>
      <p class="text-xs text-slate-400 font-mono mt-0.5">Policy # <%= @policy.policy_number %></p>
    </div>

    <div class="text-right">
      <span class="text-xs text-slate-400 block font-medium">Sum Assured</span>
      <span class="text-lg font-extrabold text-white font-mono">
        <%= Core::CurrencyFormatter.format_compact(@policy.sum_assured) %>
      </span>
    </div>
  </div>

  <div class="mt-4 pt-4 border-t border-slate-800/80 grid grid-cols-2 gap-4 text-xs">
    <div>
      <span class="text-slate-400 block">Premium</span>
      <span class="font-semibold text-slate-200">
        <%= Core::CurrencyFormatter.format_inr(@policy.premium_amount) %> / <%= @policy.premium_frequency %>
      </span>
    </div>
    <div class="text-right">
      <span class="text-slate-400 block">Valid Until</span>
      <span class="font-semibold text-slate-200">
        <%= @policy.end_date.strftime("%d %b %Y") %>
        <span class="text-slate-400">(<%= @policy.days_to_renewal %> days left)</span>
      </span>
    </div>
  </div>
</div>

