<div class="relative custom-datepicker" id="dp-<%= @id %>">
  <% if @label.present? %>
    <label class="block text-xs font-medium text-slate-300 mb-1"><%= @label %></label>
  <% end %>
  <input type="hidden" name="<%= @name %>" id="dp-input-<%= @id %>" value="<%= @value %>">
  <button type="button"
          onclick="toggleDatePicker('<%= @id %>')"
          class="w-full flex items-center justify-between rounded-xl bg-slate-800/90 border border-slate-700/80 px-3.5 py-2.5 text-xs text-white font-mono shadow-inner hover:border-indigo-500/70 focus:outline-none focus:border-indigo-500 transition-all">
    <span id="dp-label-<%= @id %>"><%= formatted_display %></span>
    <svg class="w-4 h-4 text-indigo-400 shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
  </button>
  <div id="dp-pop-<%= @id %>"
       class="datepicker-popover hidden absolute left-0 mt-2 w-72 z-50 origin-top rounded-2xl bg-slate-900/95 backdrop-blur-xl border border-slate-700/80 shadow-2xl shadow-black/80 ring-1 ring-white/10 p-4 select-none">
  </div>
</div>

