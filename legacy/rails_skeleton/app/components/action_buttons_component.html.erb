<div class="inline-flex items-center justify-end gap-1.5">
  <button type="button"
          onclick="openModal('<%= @category %>'<%= @record_id ? ", #{@record_id}" : "" %>)"
          title="Edit <%= @label %>"
          class="p-1.5 rounded-lg bg-indigo-500/10 text-indigo-400 hover:bg-indigo-500/20 border border-indigo-500/20 transition-colors inline-flex items-center justify-center">
    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
    </svg>
  </button>

  <% if @show_delete && @record_id %>
    <button type="button"
            onclick="deleteItem('<%= @category %>', <%= @record_id %>, '<%= j(@label) %>')"
            title="Remove <%= @label %>"
            class="p-1.5 rounded-lg bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 border border-rose-500/20 transition-colors inline-flex items-center justify-center">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    </button>
  <% end %>
</div>

