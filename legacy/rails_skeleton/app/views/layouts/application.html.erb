<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <title>WealthFlow | Modular Financial & Insurance Platform</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application.tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans">
    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-50 bg-slate-950/80 backdrop-blur-xl border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-emerald-400 p-0.5 shadow-lg shadow-indigo-500/20">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
              <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
          </div>
          <div>
            <span class="text-lg font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-indigo-300 bg-clip-text text-transparent">
              WealthFlow
            </span>
            <span class="block text-[10px] font-mono tracking-widest uppercase text-slate-400">Rails 8.1 Modular Monolith</span>
          </div>
        </div>

        <nav class="flex items-center gap-3">
          <%= link_to root_path, class: "px-3.5 py-1.5 rounded-lg text-xs font-semibold text-white bg-slate-800/80 hover:bg-slate-800 transition-colors border border-slate-700/60" do %>
            Dashboard
          <% end %>

          <div class="h-4 w-px bg-slate-800"></div>

          <% if user_signed_in? %>
            <div class="flex items-center gap-3">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-indigo-600/30 border border-indigo-500/40 text-indigo-300 font-bold text-xs flex items-center justify-center font-mono">
                  <%= current_user.initials %>
                </div>
                <span class="text-xs font-medium text-slate-300 hidden sm:inline"><%= current_user.name %></span>
              </div>
              <%= button_to destroy_user_session_path, method: :delete, class: "px-2.5 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-rose-400 hover:bg-rose-950/30 border border-slate-800 hover:border-rose-900/40 transition-colors" do %>
                Sign Out
              <% end %>
            </div>
          <% else %>
            <div class="flex items-center gap-2">
              <%= link_to "Sign In", new_user_session_path, class: "px-3 py-1.5 rounded-lg text-xs font-medium text-slate-300 hover:text-white" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "btn-primary px-3 py-1.5 text-xs" %>
            </div>
          <% end %>
        </nav>
      </div>
    </header>

    <!-- Flash Notifications -->
    <% if notice.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="p-3.5 rounded-xl bg-emerald-950/70 border border-emerald-800/60 text-emerald-300 text-xs flex items-center justify-between">
          <span><%= notice %></span>
          <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-white">&times;</button>
        </div>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="p-3.5 rounded-xl bg-rose-950/70 border border-rose-800/60 text-rose-300 text-xs flex items-center justify-between">
          <span><%= alert %></span>
          <button onclick="this.parentElement.remove()" class="text-rose-400 hover:text-white">&times;</button>
        </div>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-900 bg-slate-950/60 py-6 text-center text-xs text-slate-400">
      <p>WealthFlow Financial Platform • Rails 8.1 • ViewComponent • Turbo 8 • Stimulus • Motion.js</p>
    </footer>
  </body>
</html>

