<%# app/views/devise/registrations/new.html.erb %>
<div class="max-w-md mx-auto my-12">
  <div class="glass-card p-8 border-slate-800">
    <div class="text-center mb-6">
      <div class="inline-flex w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 items-center justify-center mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
        </svg>
      </div>
      <h2 class="text-2xl font-extrabold text-white">Create WealthFlow Account</h2>
      <p class="text-xs text-slate-400 mt-1">Start tracking investments, deposits, and insurance</p>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-4">
        <div>
          <%= f.label :name, "Full Name", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.text_field :name, autofocus: true, autocomplete: "name", class: "input-field", placeholder: "e.g. Sayan Banerjee" %>
        </div>

        <div>
          <%= f.label :email, "Email Address", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.email_field :email, autocomplete: "email", class: "input-field", placeholder: "you@example.com" %>
        </div>

        <div>
          <%= f.label :annual_income, "Annual Gross Income (₹)", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :annual_income, step: 50000, value: 1500000, class: "input-field", placeholder: "1500000" %>
          <span class="text-[10px] text-slate-500 block mt-0.5">Used for calculating Life Insurance adequacy ratio (HLV)</span>
        </div>

        <div>
          <%= f.label :password, "Password", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "input-field", placeholder: "•••••••• (6+ characters)" %>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-field", placeholder: "••••••••" %>
        </div>

        <div>
          <%= f.submit "Create Portfolio", class: "w-full btn-primary py-3" %>
        </div>
      </div>
    <% end %>

    <div class="mt-6 pt-6 border-t border-slate-800 text-center text-xs text-slate-400">
      Already registered?
      <%= link_to "Sign in here", new_session_path(resource_name), class: "text-indigo-400 hover:text-indigo-300 font-medium ml-1" %>
    </div>
  </div>
</div>

