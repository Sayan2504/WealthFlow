<%# app/views/devise/sessions/new.html.erb %>
<div class="max-w-md mx-auto my-12">
  <div class="glass-card p-8 border-slate-800">
    <div class="text-center mb-6">
      <div class="inline-flex w-12 h-12 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 items-center justify-center mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h2 class="text-2xl font-extrabold text-white">Sign In to WealthFlow</h2>
      <p class="text-xs text-slate-400 mt-1">Access your consolidated financial command center</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-4">
        <div>
          <%= f.label :email, "Email Address", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field", placeholder: "you@example.com" %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <%= f.label :password, "Password", class: "block text-xs font-medium text-slate-300" %>
            <% if devise_mapping.recoverable? %>
              <%= link_to "Forgot?", new_password_path(resource_name), class: "text-xs text-indigo-400 hover:text-indigo-300" %>
            <% end %>
          </div>
          <%= f.password_field :password, autocomplete: "current-password", class: "input-field", placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "rounded bg-slate-800 border-slate-700 text-indigo-500 focus:ring-indigo-500" %>
            <%= f.label :remember_me, "Remember this device for 30 days", class: "text-xs text-slate-400" %>
          </div>
        <% end %>

        <div>
          <%= f.submit "Sign In", class: "w-full btn-primary py-3" %>
        </div>
      </div>
    <% end %>

    <div class="mt-6 pt-6 border-t border-slate-800 text-center text-xs text-slate-400">
      Don't have an account yet?
      <%= link_to "Create an account", new_registration_path(resource_name), class: "text-indigo-400 hover:text-indigo-300 font-medium ml-1" %>
    </div>
  </div>
</div>

