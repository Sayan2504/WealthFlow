<%# app/views/dashboard/index.html.erb %>
<div class="space-y-8">
  <!-- Top Welcome & Status Banner -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-800">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-white">
        Portfolio Command Center
      </h1>
      <p class="text-sm text-slate-400 mt-1">
        Consolidated real-time asset valuation, actuarial protection, and predictive wealth projection.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2.5">
      <div class="px-3.5 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs">
        <span class="text-slate-500 block text-[10px]">Life Coverage</span>
        <div class="flex items-center gap-1 font-bold font-mono">
          <span class="text-<%= @snapshot[:insurance][:adequacy_status][:color] %>-400">
            <%= @snapshot[:insurance][:adequacy_ratio] %>%
          </span>
          <span class="text-slate-400 text-[10px]">(<%= @snapshot[:insurance][:adequacy_status][:label] %>)</span>
        </div>
      </div>

      <div class="px-3.5 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs">
        <span class="text-slate-500 block text-[10px]">Portfolio XIRR</span>
        <span class="text-emerald-400 font-bold font-mono text-sm">
          <%= @snapshot[:overall_xirr] %>%
        </span>
      </div>

      <!-- Quick Add Buttons -->
      <div class="flex items-center gap-1.5">
        <%= link_to new_mutual_fund_path, class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 transition-all shadow-md shadow-indigo-600/30" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          <span>MF</span>
        <% end %>

        <%= link_to new_deposit_account_path, class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          <span>FD/RD</span>
        <% end %>

        <%= link_to new_provident_fund_path, class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          <span>PPF/EPF</span>
        <% end %>

        <%= link_to new_insurance_policy_path, class: "inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 transition-colors" do %>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
          <span>Policy</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Primary Metric Cards (ViewComponent Grid) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <%= render FinancialMetricCardComponent.new(
      title: "Consolidated Net Worth",
      amount: @snapshot[:net_worth],
      subtitle: "Total liquidated & compounding assets",
      trend: :up,
      change_percent: 14.8,
      icon: "wallet",
      accent_color: "indigo"
    ) %>

    <%= render FinancialMetricCardComponent.new(
      title: "Mutual Funds Equity",
      amount: @snapshot[:breakdown][:mutual_funds][:current],
      subtitle: "Invested: #{Core::CurrencyFormatter.format_compact(@snapshot[:breakdown][:mutual_funds][:invested])}",
      trend: :up,
      change_percent: @snapshot[:breakdown][:mutual_funds][:xirr],
      icon: "trending-up",
      accent_color: "emerald"
    ) %>

    <%= render FinancialMetricCardComponent.new(
      title: "Fixed Income (FD & RD)",
      amount: @snapshot[:breakdown][:fixed_income][:current],
      subtitle: "#{current_user.deposit_accounts.count} active deposits across banks",
      trend: :neutral,
      icon: "safe",
      accent_color: "cyan"
    ) %>

    <%= render FinancialMetricCardComponent.new(
      title: "Retirement Corpus (PPF/EPF)",
      amount: @snapshot[:breakdown][:retirement][:total],
      subtitle: "PPF: #{Core::CurrencyFormatter.format_compact(@snapshot[:breakdown][:retirement][:ppf])} • EPF: #{Core::CurrencyFormatter.format_compact(@snapshot[:breakdown][:retirement][:epf])}",
      trend: :up,
      icon: "currency-rupee",
      accent_color: "amber"
    ) %>
  </div>

  <!-- Secondary Metrics: Insurance Shield -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div class="glass-card p-6 border-slate-800">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2.5">
          <div class="p-2 rounded-xl bg-teal-500/10 text-teal-400 border border-teal-500/20">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-white">Health Insurance Shield</h3>
            <p class="text-xs text-slate-400">Hospitalization & critical medical cover</p>
          </div>
        </div>
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-teal-950/60 text-teal-400 border border-teal-800/40 font-medium">
          2 Active Policies
        </span>
      </div>

      <div class="flex items-baseline justify-between mt-4 pt-4 border-t border-slate-800">
        <div>
          <span class="text-xs text-slate-400 block">Total Sum Assured</span>
          <span class="text-2xl font-black text-white font-mono">
            <%= Core::CurrencyFormatter.format_inr(@snapshot[:insurance][:health_cover]) %>
          </span>
        </div>
        <div class="text-right">
          <span class="text-xs text-slate-400 block">Annual Premium</span>
          <span class="text-sm font-bold text-slate-300 font-mono">
            <%= Core::CurrencyFormatter.format_inr(@snapshot[:insurance][:health_annual_premium]) %>/yr
          </span>
        </div>
      </div>
    </div>

    <div class="glass-card p-6 border-slate-800">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2.5">
          <div class="p-2 rounded-xl bg-sky-500/10 text-sky-400 border border-sky-500/20">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-white">Pure Term Life Protection</h3>
            <p class="text-xs text-slate-400">Human Life Value (HLV) risk replacement</p>
          </div>
        </div>
        <span class="text-xs px-2.5 py-0.5 rounded-full bg-sky-950/60 text-sky-400 border border-sky-800/40 font-medium">
          2 Active Term Plans
        </span>
      </div>

      <div class="flex items-baseline justify-between mt-4 pt-4 border-t border-slate-800">
        <div>
          <span class="text-xs text-slate-400 block">Total Life Cover</span>
          <span class="text-2xl font-black text-white font-mono">
            <%= Core::CurrencyFormatter.format_inr(@snapshot[:insurance][:life_cover]) %>
          </span>
        </div>
        <div class="text-right">
          <span class="text-xs text-slate-400 block">Annual Premium</span>
          <span class="text-sm font-bold text-slate-300 font-mono">
            <%= Core::CurrencyFormatter.format_inr(@snapshot[:insurance][:life_annual_premium]) %>/yr
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Asset Allocation Visualizer (ViewComponent) -->
  <%= render AssetAllocationChartComponent.new(
    allocation: @snapshot[:allocation],
    breakdown: @snapshot[:breakdown]
  ) %>

  <!-- Interactive Calculators Hub -->
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-white">Financial Calculation Engines</h2>
        <p class="text-xs text-slate-400">Statutory and market projection tools with instant Turbo Stream reactive updates</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <%= render "calculators/fd_calculator" %>
      <%= render "calculators/rd_calculator" %>
      <%= render "calculators/sip_calculator" %>
      <%= render "calculators/epf_calculator" %>
    </div>
  </div>

  <!-- Deep Dive Detail Tables -->
  <div class="space-y-8 pt-4">
    <!-- Mutual Funds Table Section (Turbo Updatable) -->
    <%= render "mutual_funds/table_section", mutual_funds: @mutual_funds %>

    <!-- Fixed Income Accounts Table -->
    <div class="glass-card overflow-hidden">
      <div class="p-6 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-white">Fixed Income Deposits (FD, RD & Flexi-RD)</h3>
          <p class="text-xs text-slate-400">Guaranteed rate instruments with compounding schedules</p>
        </div>
        <span class="text-xs px-3 py-1 rounded-full bg-emerald-950/80 text-emerald-400 border border-emerald-800/60 font-mono">
          <%= @deposit_accounts.count %> Accounts
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-900/60 text-slate-400 uppercase tracking-wider text-[11px] border-b border-slate-800">
            <tr>
              <th class="px-6 py-3.5">Institution</th>
              <th class="px-6 py-3.5">Account Type</th>
              <th class="px-6 py-3.5 text-right">Interest Rate</th>
              <th class="px-6 py-3.5 text-right">Invested Sum</th>
              <th class="px-6 py-3.5 text-right">Current Value</th>
              <th class="px-6 py-3.5 text-right">Projected Maturity</th>
              <th class="px-6 py-3.5">Maturity Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 text-slate-300">
            <% @deposit_accounts.each do |dep| %>
              <tr class="hover:bg-slate-850/60 transition-colors">
                <td class="px-6 py-4 font-semibold text-white">
                  <%= dep.institution_name %>
                  <% if dep.tax_saving %>
                    <span class="ml-1 text-[10px] text-amber-400 font-normal">★ 80C Tax Saver</span>
                  <% end %>
                </td>
                <td class="px-6 py-4">
                  <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono text-[10px]">
                    <%= dep.account_type.titleize %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right font-mono font-bold text-emerald-400">
                  <%= dep.interest_rate %>%
                </td>
                <td class="px-6 py-4 text-right font-mono"><%= Core::CurrencyFormatter.format_inr(dep.total_invested) %></td>
                <td class="px-6 py-4 text-right font-mono font-semibold text-white"><%= Core::CurrencyFormatter.format_inr(dep.current_value) %></td>
                <td class="px-6 py-4 text-right font-mono font-bold text-indigo-400"><%= Core::CurrencyFormatter.format_inr(dep.maturity_amount) %></td>
                <td class="px-6 py-4 text-slate-400 font-mono"><%= dep.maturity_date.strftime("%d %b %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Retirement Funds (PPF & EPF) -->
    <div class="glass-card overflow-hidden">
      <div class="p-6 border-b border-slate-800 flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-white">Retirement Schemes (PPF & EPF)</h3>
          <p class="text-xs text-slate-400">Statutory long-term compounding ledgers and pension buffers</p>
        </div>
      </div>

      <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
        <% @provident_funds.each do |pf| %>
          <div class="p-5 rounded-xl bg-slate-850 border border-slate-700/60">
            <div class="flex items-center justify-between mb-3">
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-amber-400">
                  <%= pf.fund_type.upcase %> Scheme
                </span>
                <p class="text-xs text-slate-400 font-mono"><%= pf.account_identifier %></p>
              </div>
              <span class="text-xs font-mono font-bold text-emerald-400 px-2 py-0.5 rounded bg-emerald-950/60 border border-emerald-800/40">
                <%= pf.current_interest_rate %>% p.a.
              </span>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-700/60 flex items-baseline justify-between">
              <div>
                <span class="text-xs text-slate-400 block">Current Balance</span>
                <span class="text-2xl font-black text-white font-mono">
                  <%= Core::CurrencyFormatter.format_inr(pf.total_balance) %>
                </span>
              </div>
              <div class="text-right">
                <span class="text-xs text-slate-400 block">Interest Credited</span>
                <span class="text-sm font-semibold text-emerald-400 font-mono">
                  +<%= Core::CurrencyFormatter.format_inr(pf.total_interest_credited) %>
                </span>
              </div>
            </div>

            <% if pf.epf? %>
              <div class="mt-3 pt-3 border-t border-slate-800 grid grid-cols-3 gap-2 text-[11px]">
                <div>
                  <span class="text-slate-500 block">Employee Pool</span>
                  <span class="font-mono text-slate-300 font-semibold"><%= Core::CurrencyFormatter.format_compact(pf.employee_balance) %></span>
                </div>
                <div>
                  <span class="text-slate-500 block">Employer Pool</span>
                  <span class="font-mono text-slate-300 font-semibold"><%= Core::CurrencyFormatter.format_compact(pf.employer_balance) %></span>
                </div>
                <div>
                  <span class="text-slate-500 block">EPS Pension Pool</span>
                  <span class="font-mono text-amber-300 font-semibold"><%= Core::CurrencyFormatter.format_compact(pf.pension_balance) %></span>
                </div>
              </div>
            <% end %>

            <!-- Expandable Passbook Ledger -->
            <details class="mt-4 pt-3 border-t border-slate-800 text-xs group">
              <summary class="cursor-pointer text-indigo-400 hover:text-indigo-300 font-medium flex items-center justify-between select-none">
                <span>View Passbook History (<%= pf.provident_fund_ledgers.count %> entries)</span>
                <span class="text-slate-500 group-open:rotate-180 transition-transform">▼</span>
              </summary>

              <div class="mt-3 space-y-2 overflow-x-auto">
                <table class="w-full text-left text-[11px] text-slate-300">
                  <thead class="text-slate-500 uppercase text-[9px] border-b border-slate-800">
                    <tr>
                      <th class="py-1.5">Date</th>
                      <th class="py-1.5 text-right">Employee</th>
                      <% if pf.epf? %>
                        <th class="py-1.5 text-right">Employer</th>
                        <th class="py-1.5 text-right">EPS</th>
                      <% end %>
                      <th class="py-1.5 text-right">Interest</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-800/40 font-mono">
                    <% pf.provident_fund_ledgers.order(entry_date: :desc).limit(5).each do |entry| %>
                      <tr>
                        <td class="py-1.5 text-slate-400"><%= entry.entry_date.strftime("%b %Y") %></td>
                        <td class="py-1.5 text-right font-medium text-white"><%= Core::CurrencyFormatter.format_compact(entry.employee_share) %></td>
                        <% if pf.epf? %>
                          <td class="py-1.5 text-right text-emerald-400"><%= Core::CurrencyFormatter.format_compact(entry.employer_share) %></td>
                          <td class="py-1.5 text-right text-amber-400"><%= Core::CurrencyFormatter.format_compact(entry.pension_share) %></td>
                        <% end %>
                        <td class="py-1.5 text-right text-indigo-400">+<%= Core::CurrencyFormatter.format_compact(entry.interest_credited) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </details>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Insurance Policies Grid (ViewComponent) -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-base font-bold text-white">Active Insurance Policies</h3>
          <p class="text-xs text-slate-400">Health family floaters, top-ups, and pure term life protection</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% @health_policies.each do |hp| %>
          <%= render PolicyCardComponent.new(policy: hp) %>
        <% end %>

        <% @life_policies.each do |lp| %>
          <%= render PolicyCardComponent.new(policy: lp) %>
        <% end %>
      </div>
    </div>
  </div>
</div>

