<%# app/views/mutual_funds/new.html.erb %>
<div class="max-w-2xl mx-auto my-8">
  <div class="glass-card p-8 border-slate-800">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
      <div>
        <h2 class="text-xl font-bold text-white">Add Mutual Fund Holding</h2>
        <p class="text-xs text-slate-400">Track equity, debt, hybrid, or ELSS folios with live AMFI NAV syncing</p>
      </div>
      <%= link_to root_path, class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors" do %>
        &times; Close
      <% end %>
    </div>

    <%= form_with model: @mutual_fund, url: mutual_funds_path, method: :post, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :scheme_name, "Scheme Name", class: "block text-xs font-medium text-slate-300 mb-1" %>
        <%= f.text_field :scheme_name, class: "input-field", placeholder: "e.g. Parag Parikh Flexi Cap Fund - Direct Growth", required: true %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :folio_number, "Folio / Account Number", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.text_field :folio_number, class: "input-field", placeholder: "e.g. 10293847" %>
        </div>

        <div>
          <%= render CustomSelectComponent.new(
            name: "mutual_fund_holding[category]",
            label: "Category",
            selected: "flexi_cap",
            options: [
              ["Flexi Cap", "flexi_cap"],
              ["Large Cap", "equity_large_cap"],
              ["Mid Cap", "equity_mid_cap"],
              ["Small Cap", "equity_small_cap"],
              ["Gold ETF", "gold_etf"],
              ["Index Fund", "index"],
              ["ELSS (Tax Saver 80C)", "elss"],
              ["Debt / Liquid", "debt"],
              ["Hybrid / Balanced", "hybrid"]
            ]
          ) %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= f.label :units, "Units Held", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :units, step: 0.0001, class: "input-field", placeholder: "1250.50", required: true %>
        </div>

        <div>
          <%= f.label :invested_amount, "Invested Amount (₹)", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :invested_amount, step: 100, class: "input-field", placeholder: "100000", required: true %>
        </div>

        <div>
          <%= f.label :latest_nav, "Purchase / Current NAV (₹)", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :latest_nav, step: 0.0001, class: "input-field", placeholder: "85.20" %>
        </div>
      </div>

      <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-800">
        <%= link_to "Cancel", root_path, class: "px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white" %>
        <%= f.submit "Save Scheme", class: "btn-primary py-2.5 px-6" %>
      </div>
    <% end %>
  </div>
</div>

