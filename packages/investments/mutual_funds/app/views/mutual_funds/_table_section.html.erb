<%# app/views/mutual_funds/_table_section.html.erb %>
<div id="mutual_funds_section" class="glass-card overflow-hidden">
  <div class="p-6 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <h3 class="text-base font-bold text-white">Mutual Fund Holdings</h3>
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-indigo-950/80 text-indigo-400 border border-indigo-800/60 font-mono">
          AMFI Live
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-0.5">Real-time NAV valuations and portfolio equity allocations</p>
    </div>

    <div class="flex items-center gap-3">
      <!-- AMFI NAV Sync Button (Turbo Stream) -->
      <%= button_to sync_nav_mutual_funds_path, method: :post,
                    data: { turbo: true, disable_with: "Syncing..." },
                    class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold text-indigo-300 bg-indigo-950/60 hover:bg-indigo-900/60 border border-indigo-800/60 transition-all hover:scale-105 active:scale-95 shadow-sm shadow-indigo-900/30" do %>
        <svg class="w-3.5 h-3.5 text-indigo-400 animate-spin-hover" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Sync NAVs Now</span>
      <% end %>

      <span class="text-xs px-3 py-1 rounded-full bg-indigo-950/80 text-indigo-400 border border-indigo-800/60 font-mono">
        <%= mutual_funds.count %> Schemes
      </span>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-xs">
      <thead class="bg-slate-900/60 text-slate-400 uppercase tracking-wider text-[11px] border-b border-slate-800">
        <tr>
          <th class="px-6 py-3.5">Scheme & Folio</th>
          <th class="px-6 py-3.5">Category</th>
          <th class="px-6 py-3.5 text-right">Units</th>
          <th class="px-6 py-3.5 text-right">Invested</th>
          <th class="px-6 py-3.5 text-right">Latest NAV</th>
          <th class="px-6 py-3.5 text-right">Current Value</th>
          <th class="px-6 py-3.5 text-right">Gain</th>
          <th class="px-6 py-3.5 text-right">Action</th>
        </tr>
      </thead>
      <tbody id="mutual_funds_rows" class="divide-y divide-slate-800/60 text-slate-300">
        <% mutual_funds.each do |mf| %>
          <tr id="<%= dom_id(mf) %>" class="hover:bg-slate-850/60 transition-colors">
            <td class="px-6 py-4 font-semibold text-white">
              <%= mf.scheme_name %>
              <div class="flex items-center gap-2 mt-0.5">
                <span class="text-[11px] font-mono text-slate-500 font-normal"><%= mf.folio_number %></span>
                <% if mf.nav_date %>
                  <span class="text-[10px] text-slate-500 font-mono">NAV Date: <%= mf.nav_date.strftime("%d %b %Y") %></span>
                <% end %>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300 font-mono text-[10px]">
                <%= mf.category.titleize %>
              </span>
            </td>
            <td class="px-6 py-4 text-right font-mono"><%= sprintf("%.4f", mf.units) %></td>
            <td class="px-6 py-4 text-right font-mono"><%= Core::CurrencyFormatter.format_inr(mf.invested_amount) %></td>
            <td class="px-6 py-4 text-right font-mono text-indigo-400 font-semibold">
              ₹<%= sprintf("%.2f", mf.latest_nav || 0.0) %>
            </td>
            <td class="px-6 py-4 text-right font-mono font-bold text-white">
              <%= Core::CurrencyFormatter.format_inr(mf.current_value) %>
            </td>
            <td class="px-6 py-4 text-right font-mono font-semibold text-emerald-400">
              +<%= mf.absolute_return %>%
            </td>
            <td class="px-6 py-4 text-right">
              <%= button_to mutual_fund_path(mf), method: :delete, data: { turbo_confirm: "Remove scheme?" }, class: "text-slate-500 hover:text-rose-400 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

