<%# app/views/deposit_accounts/new.html.erb %>
<div class="max-w-2xl mx-auto my-8">
  <div class="glass-card p-8 border-slate-800">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
      <div>
        <h2 class="text-xl font-bold text-white">Add Fixed Income Deposit</h2>
        <p class="text-xs text-slate-400">Fixed Deposit (FD), Recurring Deposit (RD), or Flexi-RD</p>
      </div>
      <%= link_to root_path, class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors" do %>
        &times; Close
      <% end %>
    </div>

    <%= form_with model: @deposit_account, url: deposit_accounts_path, method: :post, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :institution_name, "Financial Institution / Bank", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.text_field :institution_name, class: "input-field", placeholder: "e.g. State Bank of India", required: true %>
        </div>

        <div>
          <%= f.label :account_type, "Deposit Type", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= render CustomSelectComponent.new(
                name: "deposit_account[account_type]",
                selected: @deposit_account.account_type || "fixed_deposit",
                options: [
                  ["Fixed Deposit (FD)", "fixed_deposit"],
                  ["Recurring Deposit (RD)", "recurring_deposit"],
                  ["Flexi RD (Variable)", "flexi_rd"]
                ]
              ) %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :principal_amount, "Principal / Initial Deposit (₹)", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :principal_amount, step: 500, class: "input-field", placeholder: "200000" %>
        </div>

        <div>
          <%= f.label :monthly_installment, "Monthly Installment (₹) [For RD]", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :monthly_installment, step: 500, class: "input-field", placeholder: "10000" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :interest_rate, "Annual Interest Rate (%)", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :interest_rate, step: 0.05, value: 7.10, class: "input-field", required: true %>
        </div>

        <div>
          <%= f.label :compounding_frequency, "Compounding Interval", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= render CustomSelectComponent.new(
                name: "deposit_account[compounding_frequency]",
                selected: "quarterly",
                options: [
                  ["Quarterly (Standard Bank)", "quarterly"],
                  ["Monthly", "monthly"],
                  ["Half-Yearly", "half_yearly"],
                  ["Yearly", "yearly"]
                ]
              ) %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :start_date, "Start Date", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.date_field :start_date, value: Date.current, class: "input-field", required: true %>
        </div>

        <div>
          <%= f.label :maturity_date, "Maturity Date", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.date_field :maturity_date, value: Date.current + 3.years, class: "input-field", required: true %>
        </div>
      </div>

      <div class="flex items-center gap-2 pt-2">
        <%= f.check_box :tax_saving, class: "rounded bg-slate-800 border-slate-700 text-indigo-500 focus:ring-indigo-500" %>
        <%= f.label :tax_saving, "Tax Saving Deposit (Section 80C - 5 Year Lock-in)", class: "text-xs text-slate-300" %>
      </div>

      <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-800">
        <%= link_to "Cancel", root_path, class: "px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white" %>
        <%= f.submit "Save Deposit", class: "btn-primary py-2.5 px-6" %>
      </div>
    <% end %>
  </div>
</div>

