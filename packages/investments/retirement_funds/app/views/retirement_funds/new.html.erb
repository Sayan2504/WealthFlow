<%# app/views/provident_funds/new.html.erb %>
<div class="max-w-2xl mx-auto my-8">
  <div class="glass-card p-8 border-slate-800">
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
      <div>
        <h2 class="text-xl font-bold text-white">Add Provident Fund Account</h2>
        <p class="text-xs text-slate-400">Public Provident Fund (PPF) or Employees' Provident Fund (EPF)</p>
      </div>
      <%= link_to root_path, class: "p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors" do %>
        &times; Close
      <% end %>
    </div>

    <%= form_with model: @provident_fund, url: provident_funds_path, method: :post, class: "space-y-4" do |f| %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :fund_type, "Scheme Type", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= render CustomSelectComponent.new(
                name: "provident_fund[fund_type]",
                selected: @provident_fund.fund_type || "ppf",
                options: [
                  ["Public Provident Fund (PPF)", "ppf"],
                  ["Employees' Provident Fund (EPF)", "epf"]
                ]
              ) %>
        </div>

        <div>
          <%= f.label :account_identifier, "Account No / UAN", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.text_field :account_identifier, class: "input-field", placeholder: "e.g. UAN-10029384756", required: true %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :opening_date, "Opening Date", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.date_field :opening_date, value: Date.current - 1.year, class: "input-field", required: true %>
        </div>

        <div>
          <%= f.label :current_interest_rate, "Annual Interest Rate (%)", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :current_interest_rate, step: 0.05, value: 7.10, class: "input-field", required: true %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-slate-300 mb-1">Initial Opening Balance / Deposit (₹)</label>
        <input type="number" name="initial_deposit" step="500" value="50000" class="input-field" placeholder="50000">
        <span class="text-[10px] text-slate-500 block mt-0.5">Will generate opening entry in the scheme ledger</span>
      </div>

      <div class="pt-4 flex items-center justify-end gap-3 border-t border-slate-800">
        <%= link_to "Cancel", root_path, class: "px-4 py-2 rounded-xl text-xs font-medium text-slate-400 hover:text-white" %>
        <%= f.submit "Create Account", class: "btn-primary py-2.5 px-6" %>
      </div>
    <% end %>
  </div>
</div>

