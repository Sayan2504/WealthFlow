<div class="max-w-lg mx-auto py-8" data-controller="motion">
  <div class="glass-card rounded-2xl p-6 sm:p-8" data-motion-item>
    <h1 class="text-xl font-bold text-white mb-1">Reset Your Password</h1>
    <p class="text-xs text-slate-400 mb-6">Enter your registered email address to receive password reset instructions.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "block text-xs font-medium text-slate-300 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "you@example.com",
              class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white focus:border-indigo-500 focus:outline-none" %>
      </div>

      <%= f.submit "Send Reset Instructions",
            class: "w-full py-2.5 px-4 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-sm font-semibold text-white transition-colors cursor-pointer" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>

