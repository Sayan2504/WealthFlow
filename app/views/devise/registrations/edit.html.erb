<div class="max-w-3xl mx-auto space-y-6" data-controller="motion">
  <div class="glass-card rounded-2xl p-6 sm:p-8" data-motion-item>
    <div class="flex items-center justify-between gap-3 mb-6">
      <div>
        <h1 class="text-xl font-bold text-white">Account Profile &amp; Vault Security</h1>
        <p class="text-xs text-slate-400">Update personal details, annual income benchmark, or change password</p>
      </div>
      <%= link_to "← Back to Dashboard", root_path, class: "px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs text-slate-200 transition-colors" %>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, "Full Name", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.text_field :name, required: true,
                class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white focus:border-indigo-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :annual_income, "Annual Income (₹)", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :annual_income, step: 10_000, min: 0,
                class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm font-mono text-white focus:border-indigo-500 focus:outline-none" %>
        </div>
      </div>

      <div>
        <%= f.label :email, class: "block text-xs font-medium text-slate-300 mb-1" %>
        <%= f.email_field :email, autocomplete: "email", required: true,
              class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white focus:border-indigo-500 focus:outline-none" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-slate-800/80">
        <div>
          <%= f.label :password, "New Password (leave blank to keep current)", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.password_field :password, autocomplete: "new-password", placeholder: "Optional new password",
                class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:border-indigo-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm new password",
                class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:border-indigo-500 focus:outline-none" %>
        </div>
      </div>

      <div>
        <%= f.label :current_password, "Current Password (required to confirm changes)", class: "block text-xs font-medium text-amber-300 mb-1" %>
        <%= f.password_field :current_password, autocomplete: "current-password", required: true,
              class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white focus:border-indigo-500 focus:outline-none" %>
      </div>

      <div class="pt-2">
        <%= f.submit "Save Account Changes",
              class: "px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-sm font-semibold text-white shadow-lg shadow-indigo-500/20 transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="glass-card rounded-2xl p-5 border border-rose-500/25 flex items-center justify-between gap-4" data-motion-item>
    <div>
      <h2 class="text-sm font-bold text-rose-300">Danger Zone</h2>
      <p class="text-xs text-slate-400">Permanently delete this user login and all isolated financial records associated with it.</p>
    </div>
    <button
      type="button"
      onclick="confirmDeleteAccount()"
      class="px-3.5 py-2 rounded-xl bg-rose-950/70 hover:bg-rose-900 border border-rose-500/40 text-xs font-semibold text-rose-200 transition-colors cursor-pointer shrink-0"
    >Delete Account</button>
    <%= form_with url: registration_path(resource_name), method: :delete, id: "wf-delete-account-form", class: "hidden" do %><% end %>
  </div>
</div>

