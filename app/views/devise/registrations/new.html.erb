<div class="max-w-3xl mx-auto space-y-6 py-4" data-controller="motion">
  <div class="glass-card rounded-2xl p-6 sm:p-8" data-motion-item>
    <div class="flex items-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-cyan-500 flex items-center justify-center shadow-lg shadow-emerald-500/20">
        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-bold text-white">Create Your Private WealthFlow Account</h1>
        <p class="text-xs text-slate-400">New accounts start with a completely isolated portfolio vault — 100% separate from other users</p>
      </div>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, "Full Name", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.text_field :name, autofocus: true, required: true, placeholder: "Aarav Verma",
                class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:border-indigo-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :annual_income, "Annual Income (₹)", class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.number_field :annual_income, value: resource.annual_income || 1_800_000, step: 10_000, min: 0,
                class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm font-mono text-white focus:border-indigo-500 focus:outline-none" %>
        </div>
      </div>

      <div>
        <%= f.label :email, class: "block text-xs font-medium text-slate-300 mb-1" %>
        <%= f.email_field :email, autocomplete: "email", required: true, placeholder: "investor@example.com",
              class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:border-indigo-500 focus:outline-none" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :password, class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.password_field :password, autocomplete: "new-password", required: true, placeholder: "Min #{@minimum_password_length || 8} characters",
                class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:border-indigo-500 focus:outline-none" %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "block text-xs font-medium text-slate-300 mb-1" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, placeholder: "Confirm password",
                class: "w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-sm text-white placeholder-slate-500 focus:border-indigo-500 focus:outline-none" %>
        </div>
      </div>

      <%= f.submit "Create Account & Initialize Vault",
            class: "w-full py-2.5 px-4 rounded-xl bg-gradient-to-r from-emerald-600 to-cyan-600 hover:from-emerald-500 hover:to-cyan-500 text-sm font-semibold text-white shadow-lg shadow-emerald-500/20 transition-all cursor-pointer" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>

