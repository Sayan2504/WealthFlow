<!-- Unified Slide-Over Right Drawer (Forms, AI Assistant, Inspections — Zero Modals/Popups) -->
<div
  id="right-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="drawer-title"
  aria-describedby="drawer-subtitle"
  class="fixed inset-0 z-50 hidden"
  aria-hidden="true"
>
  <div id="drawer-backdrop" data-action="click->cockpit#closeDrawer" onclick="if(!window.Stimulus) closeDrawer()" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm opacity-0"></div>
  <div class="fixed inset-y-0 right-0 flex max-w-full pl-8 sm:pl-10">
    <div id="drawer-panel" tabindex="-1" class="w-screen max-w-2xl bg-slate-900 border-l border-slate-700/80 shadow-2xl translate-x-full flex flex-col will-change-transform focus:outline-none">
      <div id="drawer-header" class="px-6 py-4 border-b border-slate-800 flex items-center justify-between shrink-0">
        <div>
          <h3 id="drawer-title" class="text-base font-bold text-white">Workspace</h3>
          <p id="drawer-subtitle" class="text-xs text-slate-400 mt-0.5"></p>
        </div>
        <button type="button" data-action="click->cockpit#closeDrawer" onclick="if(!window.Stimulus) closeDrawer()" class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer" aria-label="Close Drawer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div id="drawer-body" class="flex-1 overflow-y-auto p-6 card-scroll"></div>
      <div id="drawer-footer" class="hidden px-6 py-4 border-t border-slate-800 flex items-center justify-end gap-2.5 bg-slate-900/95 shrink-0">
        <button type="button" id="drawer-cancel-btn" data-action="click->cockpit#closeDrawer" onclick="if(!window.Stimulus) closeDrawer()" class="px-4 py-2 rounded-xl text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors cursor-pointer">Cancel</button>
        <button type="button" id="drawer-submit-btn" onclick="submitModalForm()" class="wf-cta-solid px-4 py-2 rounded-xl text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 shadow-lg shadow-indigo-500/25 transition-colors cursor-pointer">Save Changes</button>
      </div>
    </div>
  </div>
</div>
