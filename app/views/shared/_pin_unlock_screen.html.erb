<div id="pin-unlock-screen" class="max-w-md mx-auto mt-16 glass-card rounded-2xl p-6 space-y-4 text-center" data-controller="motion">
  <div class="w-12 h-12 mx-auto rounded-2xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-300">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
    </svg>
  </div>
  <div>
    <h1 class="text-lg font-bold text-white">WealthFlow Cockpit Locked</h1>
    <p class="text-xs text-slate-400 mt-1">Enter your security PIN to access your portfolio data.</p>
  </div>
  <form data-action="submit->cockpit#unlockSession" onsubmit="if(!window.Stimulus){event.preventDefault();unlockCockpitSession();}" class="space-y-3">
    <div class="relative flex items-center">
      <input type="password" id="unlock-pin-input" autocomplete="current-password" placeholder="Enter Security PIN" class="w-full pl-3.5 pr-10 py-2.5 rounded-xl bg-slate-950/90 border border-slate-700 text-center text-sm font-mono text-white focus:border-indigo-500 focus:outline-none">
      <button type="button" data-action="click->cockpit#togglePinVisibility" data-cockpit-target-id-param="unlock-pin-input" onclick="if(!window.Stimulus) wfTogglePinVisibility('unlock-pin-input', this)" aria-label="Show PIN" aria-pressed="false" data-no-motion-press class="absolute right-2.5 p-1 rounded-lg text-slate-400 hover:text-white transition-colors cursor-pointer">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.9" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </button>
    </div>
    <button type="submit" class="w-full py-2.5 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-500/25 transition-colors">Unlock Portfolio</button>
  </form>
</div>
