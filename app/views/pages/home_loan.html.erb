<% content_for :title, "WealthFlow — Home Loan & Mortgage Amortization" %>

<% hl_g = @ov.dig(:graphs, :home_loan_paydown) || {} %>

<div class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-white tracking-tight">Home Loan &amp; Mortgage Amortization</h1>
      <p class="text-xs text-slate-400 mt-1">Sanctioned principal, monthly EMI breakdown, principal decrease curve &amp; linked loan protection</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" onclick="openEditModal('home_loan', 0)" class="wf-cta-solid px-3.5 py-2 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition-colors cursor-pointer">
        Edit Home Loan
      </button>
      <button type="button" onclick="openAddModal('home_loan_insurance')" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-rose-600 hover:bg-rose-500 text-white transition-colors cursor-pointer">
        + Add Home Loan Cover
      </button>
    </div>
  </div>

  <!-- 4 Summary KPI Cards -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="glass-card rounded-2xl p-4">
      <div class="text-[11px] uppercase tracking-wider text-rose-300 font-semibold">Outstanding Principal</div>
      <div class="mt-1.5 text-xl font-bold font-mono text-white"><%= format_inr(@home_loan[:outstanding_principal]) %></div>
      <div class="text-[11px] text-slate-400 mt-1">Sanctioned: <span class="font-mono text-slate-200"><%= format_inr(@home_loan[:original_loan_amount]) %></span></div>
    </div>

    <div class="glass-card rounded-2xl p-4">
      <div class="flex items-center justify-between gap-2">
        <div class="text-[11px] uppercase tracking-wider text-emerald-300 font-semibold">Principal Repaid</div>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"><%= @home_loan[:repaid_pct] %>% Repaid</span>
      </div>
      <div class="mt-1.5 text-xl font-bold font-mono text-emerald-300"><%= format_inr(@home_loan[:principal_repaid]) %></div>
      <div class="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden mt-2">
        <div style="width: <%= hl_g[:repaid_pct] || @home_loan[:repaid_pct] || 0 %>%" class="h-full bg-emerald-500 rounded-full"></div>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-4">
      <div class="text-[11px] uppercase tracking-wider text-indigo-300 font-semibold">Monthly EMI &amp; Interest Rate</div>
      <div class="mt-1.5 text-xl font-bold font-mono text-white"><%= format_inr(@home_loan[:monthly_emi]) %>/mo</div>
      <div class="text-[11px] text-slate-400 mt-1">
        @ <span class="font-mono text-indigo-300"><%= format_num(@home_loan[:interest_rate], 2) %>% p.a.</span> • Std Formula EMI: <span class="font-mono text-slate-200"><%= format_inr(@home_loan[:auto_emi]) %></span>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-4">
      <div class="text-[11px] uppercase tracking-wider text-cyan-300 font-semibold">Tenure &amp; EMI Schedule</div>
      <div class="mt-1.5 text-xl font-bold font-mono text-white"><%= format_num(@home_loan[:tenure_years], 0) %> Years</div>
      <div class="text-[11px] text-slate-400 mt-1">
        Debit Day: <span class="font-mono text-slate-200"><%= @home_loan[:emi_day] %>th of month</span> • Start: <span class="font-mono text-slate-200"><%= format_date_dmy(@home_loan[:loan_start_date], "—") %></span>
      </div>
    </div>
  </section>

  <!-- Home Loan Principal Decrease Tracker (Graph + Milestones) -->
  <section class="glass-card rounded-2xl p-5 space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-sm font-bold text-white">Home Loan Principal Decrease Tracker</h2>
        <p class="text-xs text-slate-400">Sanctioned principal paydown trajectory &amp; balance reduction milestones</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
          <%= format_num(hl_g[:repaid_pct], 1) %>% Reduced
        </span>
        <button type="button" onclick="openEditModal('home_loan', 0)" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-colors cursor-pointer">
          Update Balance
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-center">
      <div class="lg:col-span-7 rounded-xl bg-slate-950/70 border border-slate-800 p-4">
        <% if hl_g.dig(:svg, :line_points).present? %>
          <svg viewBox="0 0 <%= hl_g.dig(:svg, :width) || 320 %> <%= hl_g.dig(:svg, :height) || 84 %>" class="w-full h-32 overflow-visible" role="img" aria-label="Home loan principal decrease trajectory">
            <defs>
              <linearGradient id="grad-page-hl" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.32"/>
                <stop offset="100%" stop-color="#10b981" stop-opacity="0.03"/>
              </linearGradient>
            </defs>
            <polygon points="<%= hl_g.dig(:svg, :area_points) %>" fill="url(#grad-page-hl)"/>
            <polyline points="<%= hl_g.dig(:svg, :line_points) %>" fill="none" stroke="#fb7185" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <% Array(hl_g.dig(:svg, :dots)).each_with_index do |dot, idx| %>
              <circle cx="<%= dot[:x] %>" cy="<%= dot[:y] %>" r="<%= idx == 2 ? 5 : 3 %>" fill="<%= idx == 2 ? '#fbbf24' : '#fb7185' %>" stroke="#0f172a" stroke-width="1.5"/>
            <% end %>
          </svg>
        <% end %>
        <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 px-1 mt-1.5">
          <span>Sanction: <%= format_compact(hl_g[:original]) %></span>
          <span class="text-amber-300 font-bold">Now: <%= format_compact(hl_g[:outstanding]) %></span>
          <span>Target: ₹0</span>
        </div>
      </div>

      <div class="lg:col-span-5 space-y-2.5">
        <div class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Amortization Milestones</div>
        <div class="space-y-2">
          <% Array(hl_g[:milestones]).each do |m| %>
            <div class="rounded-xl p-2.5 border <%= m[:current] ? 'bg-amber-500/10 border-amber-500/40' : 'bg-slate-900/70 border-slate-800' %>">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="<%= m[:current] ? 'text-amber-300 font-bold' : 'text-slate-300' %>"><%= m[:label] %></span>
                <span class="font-mono font-semibold text-white">
                  <%= format_inr(m[:value]) %>
                  <span class="text-[10px] text-slate-400 ml-1">(<%= format_num(m[:pct], 1) %>%)</span>
                </span>
              </div>
              <div class="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden">
                <div style="width: <%= m[:pct] || 0 %>%" class="h-full <%= m[:current] ? 'bg-amber-400' : 'bg-rose-500/80' %> rounded-full"></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div>
      <div class="flex items-center justify-between text-xs text-slate-400 mb-1.5">
        <span>Overall Principal Repayment Progress</span>
        <span class="font-mono text-slate-200"><%= format_num(hl_g[:repaid_pct], 1) %>% Repaid • <%= format_num(hl_g[:remaining_pct], 1) %>% Remaining</span>
      </div>
      <div class="w-full h-2.5 rounded-full bg-slate-800 overflow-hidden flex">
        <div style="width: <%= hl_g[:repaid_pct] || 0 %>%" class="h-full bg-emerald-500"></div>
        <div style="width: <%= hl_g[:remaining_pct] || 0 %>%" class="h-full bg-rose-500/70"></div>
      </div>
    </div>
  </section>

  <!-- Linked Home Loan & Property Protection Policies -->
  <%= render partial: "pages/policy_table", locals: {
        title: "Home Loan & Property Protection",
        subtitle: "Mortgage cover & property structure insurance",
        entity_type: "home_loan_insurance",
        policies: @home_loan_policies,
        btn_class: "bg-rose-600 hover:bg-rose-500 text-white"
      } %>
</div>

