<% content_for :title, "WealthFlow — Portfolio Overview" %>

<div class="space-y-6">
  <%= render "shared/ad_carousel", signed_in: true %>

  <!-- Executive Net Worth Hero -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-5">
    <div class="lg:col-span-7 glass-card rounded-2xl p-6 relative overflow-hidden">
      <div class="absolute -right-12 -top-12 w-48 h-48 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none"></div>
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-indigo-300 bg-indigo-500/10 border border-indigo-500/25 px-2.5 py-1 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Consolidated Net Worth
          </span>
          <div class="mt-3 text-3xl sm:text-4xl font-extrabold font-mono tracking-tight text-white">
            <%= format_inr(@ov[:netWorth]) %>
          </div>
          <p class="mt-1.5 text-xs text-slate-400">
            Excl. RD &amp; Flexi RD: <span class="font-mono font-semibold text-slate-200"><%= format_inr(@ov[:netWorthWithoutRd]) %></span>
          </p>
        </div>
        <div class="text-right">
          <div class="text-[11px] uppercase tracking-wider text-slate-400">Total Financial Assets</div>
          <div class="text-xl font-bold font-mono text-emerald-300 mt-0.5"><%= format_inr(@ov[:totalAssets]) %></div>
          <div class="text-[11px] text-slate-400 mt-1">
            Invested: <span class="font-mono text-slate-200"><%= format_inr(@ov[:totalInvested]) %></span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-5 border-t border-slate-800/80">
        <div class="rounded-xl bg-slate-900/60 border border-slate-800/80 p-3">
          <div class="text-[11px] text-slate-400">Total Gains</div>
          <div class="text-sm font-bold font-mono <%= @ov[:totalGain].to_f >= 0 ? 'text-emerald-400' : 'text-rose-400' %> mt-0.5">
            <%= format_inr(@ov[:totalGain]) %>
          </div>
        </div>
        <div class="rounded-xl bg-slate-900/60 border border-slate-800/80 p-3">
          <div class="text-[11px] text-slate-400">Home Loan Debt</div>
          <div class="text-sm font-bold font-mono text-rose-400 mt-0.5">
            -<%= format_inr(@ov.dig(:homeLoan, :outstanding_principal)) %>
          </div>
        </div>
        <div class="rounded-xl bg-slate-900/60 border border-slate-800/80 p-3">
          <div class="text-[11px] text-slate-400">Credit Card Dues</div>
          <div class="text-sm font-bold font-mono text-amber-300 mt-0.5">
            -<%= format_inr(@ov.dig(:banking, :cards, :totalUtilized)) %>
          </div>
        </div>
        <div class="rounded-xl bg-slate-900/60 border border-slate-800/80 p-3">
          <div class="text-[11px] text-slate-400">Bank Liquidity</div>
          <div class="text-sm font-bold font-mono text-cyan-300 mt-0.5">
            <%= format_inr(@ov.dig(:banking, :accounts, :totalBalance)) %>
          </div>
        </div>
      </div>
    </div>

    <!-- Asset Allocation & Post-Tax Interest -->
    <div class="lg:col-span-5 glass-card rounded-2xl p-6 flex flex-col justify-between gap-5">
      <div>
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-bold text-white">Asset Allocation Mix</h2>
          <span class="text-[11px] text-slate-400 font-mono">100% Invested Core</span>
        </div>

        <div class="w-full h-3 rounded-full bg-slate-800 overflow-hidden flex mt-3">
          <div style="width: <%= @ov.dig(:allocation, :mfPct) %>%" class="bg-indigo-500 h-full"></div>
          <div style="width: <%= @ov.dig(:allocation, :fiPct) %>%" class="bg-emerald-500 h-full"></div>
          <div style="width: <%= @ov.dig(:allocation, :retPct) %>%" class="bg-amber-400 h-full"></div>
        </div>

        <div class="grid grid-cols-3 gap-2.5 mt-4">
          <div class="rounded-xl bg-slate-900/60 border border-slate-800/80 p-2.5">
            <div class="flex items-center gap-1.5 text-[11px] text-slate-400">
              <span class="w-2 h-2 rounded-full bg-indigo-500"></span> Mutual Funds
            </div>
            <div class="mt-1 text-xs font-bold font-mono text-white"><%= @ov.dig(:allocation, :mfPct) %>%</div>
            <div class="text-[11px] font-mono text-slate-400"><%= format_compact(@ov.dig(:mf, :current)) %></div>
          </div>
          <div class="rounded-xl bg-slate-900/60 border border-slate-800/80 p-2.5">
            <div class="flex items-center gap-1.5 text-[11px] text-slate-400">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Fixed Income
            </div>
            <div class="mt-1 text-xs font-bold font-mono text-white"><%= @ov.dig(:allocation, :fiPct) %>%</div>
            <div class="text-[11px] font-mono text-slate-400"><%= format_compact(@ov.dig(:allocation, :fiTotal)) %></div>
          </div>
          <div class="rounded-xl bg-slate-900/60 border border-slate-800/80 p-2.5">
            <div class="flex items-center gap-1.5 text-[11px] text-slate-400">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span> PPF &amp; EPF
            </div>
            <div class="mt-1 text-xs font-bold font-mono text-white"><%= @ov.dig(:allocation, :retPct) %>%</div>
            <div class="text-[11px] font-mono text-slate-400"><%= format_compact(@ov.dig(:allocation, :retTotal)) %></div>
          </div>
        </div>
      </div>

      <!-- Post-Tax Interest Quick Card -->
      <div class="rounded-xl bg-gradient-to-r from-emerald-950/60 to-slate-900/90 border border-emerald-500/30 p-4 flex items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-emerald-300">Post-Tax Interest (@ 30% Slab + 4% Cess)</span>
          </div>
          <div class="text-xl font-bold font-mono text-white mt-1">
            <%= format_inr(@ov.dig(:postTax, :postTaxGain)) %>
          </div>
          <div class="text-[11px] text-slate-400 mt-0.5">
            Gross: <%= format_inr(@ov.dig(:postTax, :totalGrossGain)) %> • Tax Est: <span class="text-rose-300"><%= format_inr(@ov.dig(:postTax, :estimatedTax)) %></span>
          </div>
        </div>
        <a href="/fixed_income" class="shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-200 border border-emerald-500/40 transition-colors">
          Switch Slab →
        </a>
      </div>
    </div>
  </section>

  <!-- 7 Module Snapshot Cards -->
  <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
    <!-- Mutual Funds -->
    <a href="/mutual_funds" class="glass-card rounded-2xl p-5 block transition-transform hover:-translate-y-0.5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">Mutual Funds</span>
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-indigo-500/15 text-indigo-300 border border-indigo-500/30"><%= Array(@data[:mutual_funds]).size %> Schemes</span>
      </div>
      <div class="mt-3 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:mf, :current)) %></div>
      <div class="mt-2 flex items-center justify-between text-xs text-slate-400">
        <span>Gain: <strong class="font-mono <%= @ov.dig(:mf, :gain).to_f >= 0 ? 'text-emerald-400' : 'text-rose-400' %>"><%= format_inr(@ov.dig(:mf, :gain)) %> (<%= format_num(@ov.dig(:mf, :gainPct), 2) %>%)</strong></span>
        <span>SIP: <strong class="font-mono text-slate-200"><%= format_inr(@ov.dig(:mf, :sip)) %>/mo</strong></span>
      </div>
    </a>

    <!-- Fixed Deposits & RDs -->
    <a href="/fixed_income" class="glass-card rounded-2xl p-5 block transition-transform hover:-translate-y-0.5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-300">Fixed Deposits &amp; RDs</span>
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"><%= @ov.dig(:fd, :count).to_i + @ov.dig(:rd, :count).to_i + @ov.dig(:flexiRd, :count).to_i %> Deposits</span>
      </div>
      <div class="mt-3 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:allocation, :fiTotal)) %></div>
      <div class="mt-2 flex items-center justify-between text-xs text-slate-400">
        <span>FD Principal: <strong class="font-mono text-slate-200"><%= format_inr(@ov.dig(:fd, :principal)) %></strong></span>
        <span>Avg FD Rate: <strong class="font-mono text-emerald-300"><%= format_num(@ov.dig(:fd, :avgRate), 2) %>%</strong></span>
      </div>
    </a>

    <!-- Retirement (PPF + EPF + ULIP) -->
    <a href="/retirement" class="glass-card rounded-2xl p-5 block transition-transform hover:-translate-y-0.5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-300">Retirement (PPF + EPF)</span>
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30">EEE Sovereign</span>
      </div>
      <div class="mt-3 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:allocation, :retTotal)) %></div>
      <div class="mt-2 flex items-center justify-between text-xs text-slate-400">
        <span>PPF (<%= format_num(@ov.dig(:ppf, :rate), 1) %>%): <strong class="font-mono text-slate-200"><%= format_compact(@ov.dig(:ppf, :balance)) %></strong></span>
        <span>EPF (<%= format_num(@ov.dig(:epf, :rate), 2) %>%): <strong class="font-mono text-slate-200"><%= format_compact(@ov.dig(:epf, :balance)) %></strong></span>
      </div>
    </a>

    <!-- Banking & Credit -->
    <a href="/banking" class="glass-card rounded-2xl p-5 block transition-transform hover:-translate-y-0.5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-cyan-300">Banking &amp; Liquidity</span>
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30"><%= @ov.dig(:banking, :accounts, :count) %> Accounts</span>
      </div>
      <div class="mt-3 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:banking, :accounts, :totalBalance)) %></div>
      <div class="mt-2 flex items-center justify-between text-xs text-slate-400">
        <span>Annual Int: <strong class="font-mono text-emerald-300"><%= format_inr(@ov.dig(:banking, :accounts, :annualInterest)) %></strong></span>
        <span>Card Dues: <strong class="font-mono text-slate-200"><%= format_inr(@ov.dig(:banking, :cards, :totalUtilized)) %></strong></span>
      </div>
    </a>

    <!-- Insurance & Protection -->
    <a href="/insurance" class="glass-card rounded-2xl p-5 block transition-transform hover:-translate-y-0.5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-rose-300">Insurance &amp; Protection</span>
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-rose-500/15 text-rose-300 border border-rose-500/30"><%= @ov.dig(:health, :count).to_i + @ov.dig(:life, :count).to_i + @ov.dig(:vehicle, :count).to_i + @ov.dig(:homeLoanIns, :count).to_i %> Policies</span>
      </div>
      <div class="mt-3 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:health, :sumInsured).to_f + @ov.dig(:life, :sumInsured).to_f) %></div>
      <div class="mt-2 flex items-center justify-between text-xs text-slate-400">
        <span>Health Cover: <strong class="font-mono text-emerald-300"><%= format_compact(@ov.dig(:health, :sumInsured)) %></strong></span>
        <span>Life Cover: <strong class="font-mono text-indigo-300"><%= format_compact(@ov.dig(:life, :sumInsured)) %></strong></span>
      </div>
    </a>

    <!-- Home Loan & Mortgage -->
    <a href="/home_loan" class="glass-card rounded-2xl p-5 block transition-transform hover:-translate-y-0.5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-orange-300">Home Loan &amp; Mortgage</span>
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"><%= @ov.dig(:homeLoan, :repaid_pct) %>% Repaid</span>
      </div>
      <div class="mt-3 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:homeLoan, :outstanding_principal)) %></div>
      <div class="mt-2 flex items-center justify-between text-xs text-slate-400">
        <span>EMI: <strong class="font-mono text-slate-200"><%= format_inr(@ov.dig(:homeLoan, :monthly_emi)) %>/mo</strong></span>
        <span>Rate: <strong class="font-mono text-rose-300"><%= format_num(@ov.dig(:homeLoan, :interest_rate), 2) %>%</strong></span>
      </div>
    </a>

    <!-- Income Tax Snapshot -->
    <a href="/tax_calculator" class="glass-card rounded-2xl p-5 block transition-transform hover:-translate-y-0.5">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-violet-300">80C / 80D &amp; ITR Tax</span>
        <span class="text-[11px] px-2 py-0.5 rounded-full bg-violet-500/15 text-violet-300 border border-violet-500/30 uppercase"><%= @ov.dig(:taxCalc, :recommendedRegime) %> Regime</span>
      </div>
      <div class="mt-3 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:tax, :totalTaxSaved)) %> <span class="text-xs font-normal text-slate-400">est. 80C/80D shield</span></div>
      <div class="mt-2 flex items-center justify-between text-xs text-slate-400">
        <span>80C: <strong class="font-mono text-emerald-300"><%= @ov.dig(:tax, :pct80C) %>%</strong></span>
        <span>80D: <strong class="font-mono text-cyan-300"><%= @ov.dig(:tax, :pct80D) %>%</strong></span>
      </div>
    </a>
  </section>

  <!-- Wealth & Asset Movement Graphs (100% Backend-Computed) -->
  <%
    graphs = @ov[:graphs] || {}
    tw = graphs[:total_wealth] || {}
    movements = graphs[:asset_movements] || {}
    mf_g = movements[:mf] || {}
    epf_g = movements[:epf] || {}
    ppf_g = movements[:ppf] || {}
    hl_g = graphs[:home_loan_paydown] || {}
  %>
  <section id="wealth-analytics-graphs" class="space-y-5">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Graph 1: Total Wealth & Net Worth Trajectory -->
      <div class="lg:col-span-7 glass-card rounded-2xl p-5 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-sm font-bold text-white">Total Wealth &amp; Net Worth Graph</h2>
            <p class="text-xs text-slate-400">Gross assets vs liabilities &amp; cumulative appreciation</p>
          </div>
          <span class="px-2.5 py-1 rounded-full text-[11px] font-mono font-bold border <%= tw[:positive] ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' : 'bg-rose-500/15 text-rose-300 border-rose-500/30' %>">
            <%= tw[:positive] ? '+' : '' %><%= format_num(tw[:gain_pct], 1) %>% Net Growth
          </span>
        </div>

        <% if tw.dig(:svg, :line_points).present? %>
          <div class="rounded-xl bg-slate-950/70 border border-slate-800/80 p-3">
            <svg viewBox="0 0 <%= tw.dig(:svg, :width) || 320 %> <%= tw.dig(:svg, :height) || 84 %>" class="w-full h-24 overflow-visible" role="img" aria-label="Total wealth progression chart">
              <defs>
                <linearGradient id="grad-wealth" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#6366f1" stop-opacity="0.38"/>
                  <stop offset="100%" stop-color="#6366f1" stop-opacity="0.02"/>
                </linearGradient>
              </defs>
              <polygon points="<%= tw.dig(:svg, :area_points) %>" fill="url(#grad-wealth)"/>
              <polyline points="<%= tw.dig(:svg, :line_points) %>" fill="none" stroke="#818cf8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <% Array(tw.dig(:svg, :dots)).each_with_index do |dot, idx| %>
                <circle cx="<%= dot[:x] %>" cy="<%= dot[:y] %>" r="<%= idx == 3 ? 4.5 : 3 %>" fill="<%= idx == 3 ? '#34d399' : '#818cf8' %>" stroke="#0f172a" stroke-width="1.5"/>
              <% end %>
            </svg>
            <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 px-1 mt-1">
              <span>Invested</span>
              <span>Mid-Cycle</span>
              <span>Gross Assets</span>
              <span>Net Worth</span>
            </div>
          </div>
        <% end %>

        <div class="space-y-2.5 text-xs">
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-slate-300">Gross Assets</span>
              <span class="font-mono font-bold text-emerald-300"><%= format_inr(tw[:gross_assets]) %></span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
              <div style="width: <%= tw[:assets_bar_pct] || 0 %>%" class="h-full bg-emerald-500 rounded-full"></div>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-slate-300">Net Worth (After Debt)</span>
              <span class="font-mono font-bold text-indigo-300"><%= format_inr(tw[:net_worth]) %></span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
              <div style="width: <%= tw[:net_worth_bar_pct] || 0 %>%" class="h-full bg-indigo-500 rounded-full"></div>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between mb-1">
              <span class="text-slate-300">Liabilities (Home Loan &amp; Cards)</span>
              <span class="font-mono font-bold text-rose-400">-<%= format_inr(tw[:liabilities]) %></span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
              <div style="width: <%= tw[:liabilities_bar_pct] || 0 %>%" class="h-full bg-rose-500 rounded-full"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Graph 2: Home Loan Principal Decrease Metric -->
      <div class="lg:col-span-5 glass-card rounded-2xl p-5 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-sm font-bold text-white">Home Loan Decrease Metric</h2>
            <p class="text-xs text-slate-400">Principal reduction curve from sanction to closure</p>
          </div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-1 rounded-full text-[11px] font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
              -<%= format_num(hl_g[:repaid_pct], 1) %>% Paid Off
            </span>
            <a href="/home_loan" class="text-[11px] font-semibold text-indigo-300 hover:text-indigo-200 transition-colors">Manage Home Loan →</a>
          </div>
        </div>

        <% if hl_g.dig(:svg, :line_points).present? %>
          <div class="rounded-xl bg-slate-950/70 border border-slate-800/80 p-3">
            <svg viewBox="0 0 <%= hl_g.dig(:svg, :width) || 320 %> <%= hl_g.dig(:svg, :height) || 84 %>" class="w-full h-24 overflow-visible" role="img" aria-label="Home loan principal decrease curve">
              <defs>
                <linearGradient id="grad-hl" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#f43f5e" stop-opacity="0.30"/>
                  <stop offset="100%" stop-color="#10b981" stop-opacity="0.03"/>
                </linearGradient>
              </defs>
              <polygon points="<%= hl_g.dig(:svg, :area_points) %>" fill="url(#grad-hl)"/>
              <polyline points="<%= hl_g.dig(:svg, :line_points) %>" fill="none" stroke="#fb7185" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <% Array(hl_g.dig(:svg, :dots)).each_with_index do |dot, idx| %>
                <circle cx="<%= dot[:x] %>" cy="<%= dot[:y] %>" r="<%= idx == 2 ? 5 : 3 %>" fill="<%= idx == 2 ? '#fbbf24' : '#fb7185' %>" stroke="#0f172a" stroke-width="1.5"/>
              <% end %>
            </svg>
            <div class="flex items-center justify-between text-[10px] font-mono text-slate-400 px-1 mt-1">
              <span>Sanction</span>
              <span>Mid</span>
              <span class="text-amber-300 font-bold">Now</span>
              <span>Future</span>
              <span>Zero</span>
            </div>
          </div>
        <% end %>

        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="rounded-xl bg-slate-900/70 border border-slate-800 p-3">
            <div class="text-[11px] text-slate-400">Principal Repaid</div>
            <div class="text-sm font-mono font-bold text-emerald-300 mt-0.5"><%= format_inr(hl_g[:repaid]) %></div>
          </div>
          <div class="rounded-xl bg-slate-900/70 border border-slate-800 p-3">
            <div class="text-[11px] text-slate-400">Remaining Debt</div>
            <div class="text-sm font-mono font-bold text-rose-400 mt-0.5"><%= format_inr(hl_g[:outstanding]) %></div>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
            <span>Amortization Progress</span>
            <span class="font-mono text-slate-200"><%= format_num(hl_g[:repaid_pct], 1) %>% reduced of <%= format_compact(hl_g[:original]) %></span>
          </div>
          <div class="w-full h-2.5 rounded-full bg-slate-800 overflow-hidden flex">
            <div style="width: <%= hl_g[:repaid_pct] || 0 %>%" class="h-full bg-emerald-500"></div>
            <div style="width: <%= hl_g[:remaining_pct] || 0 %>%" class="h-full bg-rose-500/70"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Graph 3: MF, EPF & PPF Increase / Decrease Tracker -->
    <div class="glass-card rounded-2xl p-5 space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-sm font-bold text-white">Mutual Funds, EPF &amp; PPF Increase / Decrease Tracker</h2>
          <p class="text-xs text-slate-400">Backend-computed principal vs current balance and net movement</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <% [
          { g: mf_g, grad_id: "grad-mf", stroke: "#818cf8", fill: "#6366f1", bar_cur: "bg-indigo-500", sub_a: ["Invested", mf_g[:invested]], sub_b: ["Current Value", mf_g[:current]] },
          { g: epf_g, grad_id: "grad-epf", stroke: "#34d399", fill: "#10b981", bar_cur: "bg-emerald-500", sub_a: ["Contributions", epf_g[:contributions]], sub_b: ["Total Balance", epf_g[:balance]] },
          { g: ppf_g, grad_id: "grad-ppf", stroke: "#fbbf24", fill: "#f59e0b", bar_cur: "bg-amber-500", sub_a: ["Contributed", ppf_g[:contributions]], sub_b: ["Current Balance", ppf_g[:balance]] }
        ].each do |card| %>
          <% g = card[:g] %>
          <div class="rounded-xl bg-slate-900/70 border border-slate-800 p-4 space-y-3">
            <div class="flex items-center justify-between gap-2">
              <div class="font-bold text-xs uppercase tracking-wider text-slate-200"><%= g[:label] %></div>
              <span class="px-2 py-0.5 rounded-full text-[11px] font-mono font-bold border <%= g[:positive] ? 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30' : 'bg-rose-500/15 text-rose-300 border-rose-500/30' %>">
                <%= g[:positive] ? '+' : '' %><%= format_num(g[:delta_pct], 1) %>% (<%= g[:positive] ? '+' : '' %><%= format_compact(g[:delta]) %>)
              </span>
            </div>

            <% if g.dig(:svg, :line_points).present? %>
              <svg viewBox="0 0 <%= g.dig(:svg, :width) || 280 %> <%= g.dig(:svg, :height) || 72 %>" class="w-full h-20 rounded-lg bg-slate-950/60 border border-slate-800/70 p-1 overflow-visible">
                <defs>
                  <linearGradient id="<%= card[:grad_id] %>" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="<%= card[:fill] %>" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="<%= card[:fill] %>" stop-opacity="0.02"/>
                  </linearGradient>
                </defs>
                <polygon points="<%= g.dig(:svg, :area_points) %>" fill="url(#<%= card[:grad_id] %>)"/>
                <polyline points="<%= g.dig(:svg, :line_points) %>" fill="none" stroke="<%= card[:stroke] %>" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                <% Array(g.dig(:svg, :dots)).each do |dot| %>
                  <circle cx="<%= dot[:x] %>" cy="<%= dot[:y] %>" r="2.8" fill="<%= card[:stroke] %>"/>
                <% end %>
              </svg>
            <% end %>

            <div class="space-y-2 text-[11px]">
              <div>
                <div class="flex justify-between text-slate-400 mb-0.5">
                  <span><%= card[:sub_a][0] %></span>
                  <span class="font-mono text-slate-200"><%= format_inr(card[:sub_a][1]) %></span>
                </div>
                <div class="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden">
                  <div style="width: <%= g[:bar_invested_pct] || g[:bar_principal_pct] || 0 %>%" class="h-full bg-slate-500 rounded-full"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-slate-300 mb-0.5">
                  <span><%= card[:sub_b][0] %></span>
                  <span class="font-mono font-bold text-white"><%= format_inr(card[:sub_b][1]) %></span>
                </div>
                <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
                  <div style="width: <%= g[:bar_current_pct] || g[:bar_balance_pct] || 0 %>%" class="h-full <%= card[:bar_cur] %> rounded-full"></div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- Upcoming Maturities & Renewal Watchlist -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="glass-card rounded-2xl p-5">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm font-bold text-white">Upcoming Fixed Deposit Maturities</h3>
          <p class="text-xs text-slate-400">Sorted by earliest maturity date</p>
        </div>
        <a href="/fixed_income" class="text-xs text-indigo-300 hover:text-indigo-200">View all →</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="text-[11px] uppercase text-slate-400 border-b border-slate-800">
              <th class="py-2 pr-3">Bank / FD No</th>
              <th class="py-2 px-3 text-right">Maturity Amt</th>
              <th class="py-2 px-3 text-right">Date</th>
              <th class="py-2 pl-3 text-right">Timeline</th>
            </tr>
          </thead>
          <tbody>
            <% @upcoming_fds.first(6).each do |row| %>
              <% fd = row[:raw]; c = row[:calc] %>
              <tr class="border-b border-slate-800/50 hover:bg-slate-800/30">
                <td class="py-2.5 pr-3">
                  <div class="font-semibold text-slate-100"><%= fd[:bank] %></div>
                  <div class="text-[10px] font-mono text-slate-400"><%= fd[:fd_no] %></div>
                </td>
                <td class="py-2.5 px-3 text-right font-mono font-semibold text-white"><%= format_inr(c[:maturity]) %></td>
                <td class="py-2.5 px-3 text-right font-mono text-slate-300"><%= format_date_dmy(fd[:maturity_date]) %></td>
                <td class="py-2.5 pl-3 text-right">
                  <span class="px-2 py-0.5 rounded-full text-[10px] border <%= c[:days_left_badge_class] %>"><%= c[:days_left_label] %></span>
                </td>
              </tr>
            <% end %>
            <% if @upcoming_fds.empty? %>
              <tr><td colspan="4" class="py-6 text-center text-slate-500">No fixed deposits added yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-5">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="text-sm font-bold text-white">Policy Renewal Radar</h3>
          <p class="text-xs text-slate-400">Active &amp; upcoming insurance renewals</p>
        </div>
        <a href="/insurance" class="text-xs text-indigo-300 hover:text-indigo-200">Manage policies →</a>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="text-[11px] uppercase text-slate-400 border-b border-slate-800">
              <th class="py-2 pr-3">Policy / Insurer</th>
              <th class="py-2 px-3 text-right">Cover</th>
              <th class="py-2 px-3 text-right">Expiry</th>
              <th class="py-2 pl-3 text-right">Status</th>
            </tr>
          </thead>
          <tbody>
            <% @upcoming_policies.first(6).each do |row| %>
              <% pol = row[:raw]; st = row[:status] %>
              <tr class="border-b border-slate-800/50 hover:bg-slate-800/30">
                <td class="py-2.5 pr-3">
                  <div class="font-semibold text-slate-100"><%= pol[:policy_name] %> <span class="text-[10px] text-indigo-300">(<%= pol[:category_label] %>)</span></div>
                  <div class="text-[10px] text-slate-400"><%= pol[:insurer] %></div>
                </td>
                <td class="py-2.5 px-3 text-right font-mono font-semibold text-white"><%= format_compact(pol[:sum_insured]) %></td>
                <td class="py-2.5 px-3 text-right font-mono text-slate-300"><%= format_date_dmy(pol[:end_date]) %></td>
                <td class="py-2.5 pl-3 text-right">
                  <%
                    st_cls = case st[:status]
                             when "Expired" then "bg-rose-950/80 text-rose-300 border-rose-700/60"
                             when "Renew Soon" then "bg-amber-950/80 text-amber-300 border-amber-700/60"
                             else "bg-emerald-950/80 text-emerald-300 border-emerald-700/60"
                             end
                  %>
                  <span class="px-2 py-0.5 rounded-full text-[10px] border <%= st_cls %>"><%= st[:status] %></span>
                </td>
              </tr>
            <% end %>
            <% if @upcoming_policies.empty? %>
              <tr><td colspan="4" class="py-6 text-center text-slate-500">No insurance policies added yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

