<% content_for :title, "WealthFlow — Banking & Credit Cards" %>

<div class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-white tracking-tight">Banking &amp; Credit Cards</h1>
      <p class="text-xs text-slate-400 mt-1">Savings liquidity, IFSC details, annual interest &amp; credit card utilization health</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" onclick="openAddModal('bank_account')" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-cyan-600 hover:bg-cyan-500 text-white transition-colors">
        + Add Bank Account
      </button>
      <button type="button" onclick="openAddModal('credit_card')" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition-colors">
        + Add Credit Card
      </button>
    </div>
  </div>

  <!-- Summary Cards -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="glass-card rounded-2xl p-5">
      <div class="text-xs font-semibold uppercase tracking-wider text-cyan-300">Total Bank Liquidity (<%= @ov.dig(:banking, :accounts, :count) %>)</div>
      <div class="mt-2 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:banking, :accounts, :totalBalance)) %></div>
      <div class="mt-1 text-xs text-slate-400">Est. Annual Savings Interest: <span class="font-mono text-emerald-400"><%= format_inr(@ov.dig(:banking, :accounts, :annualInterest)) %></span></div>
    </div>

    <div class="glass-card rounded-2xl p-5">
      <div class="text-xs font-semibold uppercase tracking-wider text-indigo-300">Credit Card Profile (<%= @ov.dig(:banking, :cards, :count) %>)</div>
      <div class="mt-2 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:banking, :cards, :totalAvailable)) %> <span class="text-xs font-normal text-slate-400">available</span></div>
      <div class="mt-1 text-xs text-slate-400">
        Utilized: <span class="font-mono text-amber-300"><%= format_inr(@ov.dig(:banking, :cards, :totalUtilized)) %></span> (<%= @ov.dig(:banking, :cards, :utilizationPct) %>%) • Rewards: <span class="font-mono text-slate-200"><%= format_num(@ov.dig(:banking, :cards, :totalRewardPoints)) %> pts</span>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-5">
      <div class="text-xs font-semibold uppercase tracking-wider text-emerald-300">Credit Limit &amp; Rewards</div>
      <div class="mt-2 text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:banking, :cards, :totalLimit)) %></div>
      <div class="mt-1 text-xs text-slate-400">
        Available: <span class="font-mono text-emerald-400"><%= format_inr(@ov.dig(:banking, :cards, :totalAvailable)) %></span> • Rewards: <span class="font-mono text-indigo-300"><%= format_num(@ov.dig(:banking, :cards, :totalRewardPoints)) %> pts</span>
      </div>
    </div>
  </section>

  <!-- Bank Accounts Table -->
  <section class="glass-card rounded-2xl p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-bold text-white">Bank Accounts</h2>
      <span class="text-xs text-slate-400">Active savings, salary &amp; UPI accounts</span>
    </div>
    <div class="overflow-x-auto card-scroll">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
            <th class="py-3 pr-3">Bank &amp; Type</th>
            <th class="py-3 px-3">Account / IFSC</th>
            <th class="py-3 px-3">Purpose / Nominee</th>
            <th class="py-3 px-3 text-right">Interest %</th>
            <th class="py-3 px-3 text-right">Est. Int/yr</th>
            <th class="py-3 px-3 text-right">Balance</th>
            <th class="py-3 pl-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @accounts.each do |acc| %>
            <%
              bal = acc[:current_balance].to_f
              rate = acc[:interest_rate].to_f
              est_int = (bal * (rate / 100.0)).round
            %>
            <tr class="border-b border-slate-800/60 hover:bg-slate-800/30 transition-colors">
              <td class="py-3 pr-3">
                <div class="font-semibold text-white"><%= acc[:bank_name] %></div>
                <span class="inline-block mt-0.5 px-2 py-0.5 rounded-full text-[10px] bg-slate-800 text-cyan-300 border border-slate-700"><%= acc[:account_type].presence || "Savings" %></span>
              </td>
              <td class="py-3 px-3 font-mono">
                <div class="text-slate-200"><%= acc[:account_no] %></div>
                <div class="text-[10px] text-slate-400"><%= acc[:branch_ifsc].presence || "—" %></div>
              </td>
              <td class="py-3 px-3">
                <div class="text-slate-200"><%= acc[:purpose].presence || "—" %></div>
                <div class="text-[10px] text-slate-400">Nominee: <%= acc[:nominee].presence || "Not set" %></div>
              </td>
              <td class="py-3 px-3 text-right font-mono text-emerald-300"><%= format_num(rate, 2) %>%</td>
              <td class="py-3 px-3 text-right font-mono text-slate-300"><%= format_inr(est_int) %></td>
              <td class="py-3 px-3 text-right font-mono font-bold text-white"><%= format_inr(bal, 2) %></td>
              <td class="py-3 pl-3 text-right">
                <%= render_row_action_buttons(
                      edit_onclick: "openEditModal('bank_account', #{acc[:id]})",
                      delete_onclick: "confirmDeleteItem('bank_account', #{acc[:id]}, '#{j("#{acc[:bank_name]} #{acc[:account_no]}")}')"
                    ) %>
              </td>
            </tr>
          <% end %>
          <% if @accounts.empty? %>
            <tr><td colspan="7" class="py-6 text-center text-slate-500">No bank accounts added yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Credit Cards -->
  <section class="glass-card rounded-2xl p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-bold text-white">Credit Cards &amp; Utilization Health</h2>
      <button type="button" onclick="openAddModal('credit_card')" class="text-xs text-indigo-300 hover:text-indigo-200">+ Add Credit Card</button>
    </div>

    <% if @cards.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @cards.each do |row| %>
          <% card = row[:raw]; m = row[:metrics] %>
          <div class="rounded-xl bg-slate-900/70 border border-slate-800 p-4 space-y-3">
            <div class="flex items-start justify-between gap-2">
              <div>
                <div class="text-sm font-bold text-white"><%= card[:bank_name] %> <%= card[:card_name] %></div>
                <div class="text-[11px] font-mono text-slate-400"><%= card[:network] %> •••• <%= card[:last4].presence || "0000" %></div>
              </div>
              <div class="flex items-center gap-1">
                <%= render_row_action_buttons(
                      edit_onclick: "openEditModal('credit_card', #{card[:id]})",
                      delete_onclick: "confirmDeleteItem('credit_card', #{card[:id]}, '#{j("#{card[:bank_name]} #{card[:card_name]}")}')"
                    ) %>
              </div>
            </div>

            <div class="space-y-1">
              <div class="flex items-center justify-between text-xs">
                <span class="px-2 py-0.5 rounded-full text-[10px] border <%= m[:badgeClass] %>"><%= m[:statusLabel] %></span>
                <span class="font-mono text-slate-200"><%= m[:utilizationPct] %>% used</span>
              </div>
              <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
                <div style="width: <%= [100, m[:utilizationPct].to_f].min %>%" class="h-full <%= m[:barClass] %>"></div>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-800 text-[11px]">
              <div>
                <div class="text-slate-400">Limit</div>
                <div class="font-mono font-semibold text-white"><%= format_compact(m[:limit]) %></div>
              </div>
              <div>
                <div class="text-slate-400">Utilized</div>
                <div class="font-mono font-semibold text-amber-300"><%= format_inr(m[:utilized]) %></div>
              </div>
              <div>
                <div class="text-slate-400">Available</div>
                <div class="font-mono font-semibold text-emerald-300"><%= format_compact(m[:available]) %></div>
              </div>
            </div>
            <div class="text-[10px] text-slate-400 flex items-center justify-between">
              <span>Bill: <%= card[:billing_day] || 1 %>th • Due: <%= card[:due_day] || 15 %>th</span>
              <span class="font-mono text-indigo-300"><%= format_num(card[:reward_points]) %> pts</span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="py-8 text-center text-xs text-slate-500">No credit cards added yet. Click "+ Add Credit Card" to monitor credit utilization &amp; billing dates.</div>
    <% end %>
  </section>
</div>

