<% content_for :title, "WealthFlow — Retirement (PPF, EPF & ULIP)" %>

<div class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-white tracking-tight">Retirement Corpus (PPF, EPF &amp; ULIP)</h1>
      <p class="text-xs text-slate-400 mt-1">Govt-backed EEE retirement tracking, ₹1.5L/FY 80C cap monitoring &amp; EPFO passbook ledger</p>
    </div>
    <div class="flex flex-wrap items-center gap-2" data-controller="portfolio-sync">
      <button type="button" id="sync-statutory-btn" data-action="click->portfolio-sync#syncRates" onclick="if(!window.Stimulus) syncStatutoryRetirementRates()" class="px-3.5 py-2 rounded-xl text-xs font-medium bg-amber-500/15 hover:bg-amber-500/25 text-amber-200 border border-amber-500/35 transition-colors">
        Sync Statutory Govt Rates
      </button>
      <button type="button" onclick="openAddModal('ppf_contribution')" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition-colors">
        + Add PPF Deposit
      </button>
      <button type="button" onclick="openAddModal('epf_entry')" class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white transition-colors">
        + Add EPF Entry
      </button>
    </div>
  </div>

  <!-- Summary KPIs -->
  <section class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <div class="glass-card rounded-2xl p-5 space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-amber-300">Public Provident Fund</span>
          <div class="text-[11px] text-slate-400 mt-0.5"><%= @statutory.dig(:ppf, :effective_quarter) %> • <strong class="text-amber-300 font-mono"><%= format_num(@ov.dig(:ppf, :rate), 2) %>% p.a.</strong></div>
        </div>
        <button type="button" onclick="openEditModal('ppf_balance', 0)" class="px-2.5 py-1 rounded-lg text-[11px] bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700">Edit Balance</button>
      </div>
      <div class="text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:ppf, :balance)) %></div>
      <div class="flex items-center justify-between text-xs text-slate-400">
        <span>Principal: <strong class="font-mono text-slate-200"><%= format_inr(@ov.dig(:ppf, :contribution)) %></strong></span>
        <span>Interest: <strong class="font-mono text-emerald-400">+<%= format_inr(@ov.dig(:ppf, :interest)) %></strong></span>
      </div>
      <% fy_pct = [100, ((@ov.dig(:ppf, :latestFyTotal).to_f / 150_000.0) * 100).round].min %>
      <div class="pt-1">
        <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1">
          <span>Latest FY Section 80C Limit</span>
          <span class="font-mono text-slate-200"><%= format_inr(@ov.dig(:ppf, :latestFyTotal)) %> / ₹1,50,000</span>
        </div>
        <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
          <div style="width: <%= fy_pct %>%" class="h-full bg-amber-400"></div>
        </div>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-5 space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-300">Employees' Provident Fund</span>
          <div class="text-[11px] text-slate-400 mt-0.5"><%= @statutory.dig(:epf, :effective_fy) %> • <strong class="text-emerald-300 font-mono"><%= format_num(@ov.dig(:epf, :rate), 2) %>% p.a.</strong></div>
        </div>
        <button type="button" onclick="openEditModal('epf_balance', 0)" class="px-2.5 py-1 rounded-lg text-[11px] bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700">Edit EPF</button>
      </div>
      <div class="text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:epf, :balance)) %></div>
      <div class="text-xs text-slate-400">
        ID/UAN: <span class="font-mono text-slate-200"><%= @epf[:uan].presence || @epf[:account_identifier].presence || "EPFO-UAN" %></span>
      </div>
      <div class="text-[11px] text-slate-400"><%= @statutory.dig(:epf, :authority) %></div>
    </div>

    <div class="glass-card rounded-2xl p-5 space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">ULIP Policy</span>
        <button type="button" onclick="openEditModal('ulip', 0)" class="px-2.5 py-1 rounded-lg text-[11px] bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700">Edit ULIP</button>
      </div>
      <div class="text-2xl font-bold font-mono text-white"><%= format_inr(@ov.dig(:ulip, :value)) %></div>
      <div class="text-xs font-semibold text-slate-200"><%= @ulip[:policy_name].presence || "Market-Linked ULIP" %></div>
      <div class="flex items-center justify-between text-xs text-slate-400">
        <span>Paid: <strong class="font-mono text-slate-200"><%= format_inr(@ov.dig(:ulip, :paid)) %></strong></span>
        <span>Gain: <strong class="font-mono <%= @ov.dig(:ulip, :gain).to_f >= 0 ? 'text-emerald-400' : 'text-rose-400' %>"><%= format_inr(@ov.dig(:ulip, :gain)) %></strong></span>
      </div>
    </div>
  </section>

  <!-- EPF & PPF Increase / Growth Analytics -->
  <%
    ret_movements = @ov.dig(:graphs, :asset_movements) || {}
    ppf_g = ret_movements[:ppf] || {}
    epf_g = ret_movements[:epf] || {}
  %>
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="glass-card rounded-2xl p-5 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-white">PPF Balance Increase Graph</h2>
          <p class="text-xs text-slate-400">FY deposits vs interest compounding appreciation</p>
        </div>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-amber-500/15 text-amber-300 border border-amber-500/30">
          +<%= format_num(ppf_g[:delta_pct], 1) %>% Interest Gain
        </span>
      </div>
      <% if ppf_g.dig(:svg, :line_points).present? %>
        <svg viewBox="0 0 <%= ppf_g.dig(:svg, :width) || 280 %> <%= ppf_g.dig(:svg, :height) || 72 %>" class="w-full h-24 rounded-xl bg-slate-950/60 border border-slate-800 p-2 overflow-visible">
          <defs>
            <linearGradient id="grad-ret-ppf" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.02"/>
            </linearGradient>
          </defs>
          <polygon points="<%= ppf_g.dig(:svg, :area_points) %>" fill="url(#grad-ret-ppf)"/>
          <polyline points="<%= ppf_g.dig(:svg, :line_points) %>" fill="none" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      <% end %>
      <div class="space-y-2">
        <% Array(ppf_g[:fy_bars]).each do |bar| %>
          <div>
            <div class="flex justify-between text-[11px] mb-0.5">
              <span class="font-mono text-slate-300"><%= bar[:label] %></span>
              <span class="font-mono text-white"><%= format_inr(bar[:amount]) %> (Cumul: <%= format_compact(bar[:running]) %>)</span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
              <div style="width: <%= bar[:bar_pct] %>%" class="h-full bg-amber-400 rounded-full"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <div class="glass-card rounded-2xl p-5 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-white">EPF Vault Increase Graph</h2>
          <p class="text-xs text-slate-400">Passbook monthly additions &amp; cumulative balance trajectory</p>
        </div>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
          +<%= format_num(epf_g[:delta_pct], 1) %>% Interest Gain
        </span>
      </div>
      <% if epf_g.dig(:svg, :line_points).present? %>
        <svg viewBox="0 0 <%= epf_g.dig(:svg, :width) || 280 %> <%= epf_g.dig(:svg, :height) || 72 %>" class="w-full h-24 rounded-xl bg-slate-950/60 border border-slate-800 p-2 overflow-visible">
          <defs>
            <linearGradient id="grad-ret-epf" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#10b981" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#10b981" stop-opacity="0.02"/>
            </linearGradient>
          </defs>
          <polygon points="<%= epf_g.dig(:svg, :area_points) %>" fill="url(#grad-ret-epf)"/>
          <polyline points="<%= epf_g.dig(:svg, :line_points) %>" fill="none" stroke="#34d399" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      <% end %>
      <div class="space-y-2">
        <% Array(epf_g[:entries]).each do |bar| %>
          <div>
            <div class="flex justify-between text-[11px] mb-0.5">
              <span class="font-mono text-slate-300"><%= bar[:label] %></span>
              <span class="font-mono text-white"><%= format_inr(bar[:running]) %> (+<%= format_compact(bar[:added]) %>)</span>
            </div>
            <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
              <div style="width: <%= bar[:bar_pct] %>%" class="h-full bg-emerald-500 rounded-full"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <!-- PPF Contributions by FY -->
  <section class="glass-card rounded-2xl p-5">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-sm font-bold text-white">PPF Annual &amp; Entry-Level Ledger</h2>
        <p class="text-xs text-slate-400">Grouped by Indian Financial Year (Apr–Mar)</p>
      </div>
      <button type="button" onclick="openAddModal('ppf_contribution')" class="text-xs text-indigo-300 hover:text-indigo-200">+ Add PPF Contribution</button>
    </div>
    <div class="overflow-x-auto card-scroll">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
            <th class="py-2.5 pr-3">Financial Year</th>
            <th class="py-2.5 px-3">Date / Note</th>
            <th class="py-2.5 px-3 text-right">Amount</th>
            <th class="py-2.5 px-3 text-right">FY Cap Status</th>
            <th class="py-2.5 pl-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @ppf_groups.reverse_each do |grp| %>
            <%
              diff = 150_000.0 - grp[:total_amount].to_f
              cap_badge = diff <= 0 ? ["₹1.5L Cap Full", "bg-emerald-950/80 text-emerald-300 border-emerald-700/60"] : ["#{format_inr(diff)} room left", "bg-amber-950/80 text-amber-300 border-amber-700/60"]
            %>
            <tr class="bg-slate-900/60 border-b border-slate-800/80">
              <td class="py-2.5 pr-3 font-mono font-bold text-indigo-300"><%= grp[:fy] %></td>
              <td class="py-2.5 px-3 text-slate-300"><%= grp[:entries].size %> deposit(s) in FY</td>
              <td class="py-2.5 px-3 text-right font-mono font-bold text-white"><%= format_inr(grp[:total_amount]) %></td>
              <td class="py-2.5 px-3 text-right"><span class="px-2 py-0.5 rounded-full text-[10px] border <%= cap_badge[1] %>"><%= cap_badge[0] %></span></td>
              <td class="py-2.5 pl-3 text-right text-slate-500">FY Total</td>
            </tr>
            <% grp[:entries].each do |entry| %>
              <tr class="border-b border-slate-800/40 hover:bg-slate-800/25">
                <td class="py-2 pr-3 pl-4 text-slate-500 font-mono">↳ <%= grp[:fy] %></td>
                <td class="py-2 px-3 text-slate-300">
                  <span class="font-mono"><%= format_date_dmy(entry[:date]) %></span>
                  <% if entry[:note].present? %>
                    <span class="ml-2 text-slate-400">• <%= entry[:note] %></span>
                  <% end %>
                </td>
                <td class="py-2 px-3 text-right font-mono text-slate-200"><%= format_inr(entry[:amount]) %></td>
                <td class="py-2 px-3"></td>
                <td class="py-2 pl-3 text-right">
                  <%= render_row_action_buttons(
                        edit_onclick: "openEditModal('ppf_contribution', #{entry[:id]})",
                        delete_onclick: "confirmDeleteItem('ppf_contribution', #{entry[:id]}, 'PPF Deposit #{format_date_dmy(entry[:date])}')"
                      ) %>
                </td>
              </tr>
            <% end %>
          <% end %>
          <% if @ppf_groups.empty? %>
            <tr><td colspan="5" class="py-6 text-center text-slate-500">No PPF contributions recorded yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <!-- EPF Passbook Entries -->
  <section class="glass-card rounded-2xl p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-sm font-bold text-white">EPF Passbook Ledger</h2>
      <button type="button" onclick="openAddModal('epf_entry')" class="text-xs text-emerald-300 hover:text-emerald-200">+ Add EPF Entry</button>
    </div>
    <div class="overflow-x-auto card-scroll">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="text-[11px] uppercase tracking-wider text-slate-400 border-b border-slate-800">
            <th class="py-2.5 pr-3">Date</th>
            <th class="py-2.5 px-3">Description</th>
            <th class="py-2.5 px-3 text-right">Employee Share</th>
            <th class="py-2.5 px-3 text-right">Employer Share</th>
            <th class="py-2.5 px-3 text-right">Interest</th>
            <th class="py-2.5 px-3 text-right">Total</th>
            <th class="py-2.5 pl-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @epf_entries.each do |entry| %>
            <% row_tot = entry[:employee].to_f + entry[:employer].to_f + entry[:interest].to_f %>
            <tr class="border-b border-slate-800/60 hover:bg-slate-800/30">
              <td class="py-2.5 pr-3 font-mono text-slate-300"><%= format_date_dmy(entry[:date]) %></td>
              <td class="py-2.5 px-3 font-medium text-white"><%= entry[:description].presence || "EPF Entry" %></td>
              <td class="py-2.5 px-3 text-right font-mono text-slate-200"><%= format_inr(entry[:employee]) %></td>
              <td class="py-2.5 px-3 text-right font-mono text-slate-200"><%= format_inr(entry[:employer]) %></td>
              <td class="py-2.5 px-3 text-right font-mono text-emerald-400"><%= format_inr(entry[:interest]) %></td>
              <td class="py-2.5 px-3 text-right font-mono font-bold text-white"><%= format_inr(row_tot) %></td>
              <td class="py-2.5 pl-3 text-right">
                <%= render_row_action_buttons(
                      edit_onclick: "openEditModal('epf_entry', #{entry[:id]})",
                      delete_onclick: "confirmDeleteItem('epf_entry', #{entry[:id]}, '#{j(entry[:description].presence || 'EPF Entry')}')"
                    ) %>
              </td>
            </tr>
          <% end %>
          <% if @epf_entries.empty? %>
            <tr><td colspan="7" class="py-6 text-center text-slate-500">No EPF entries recorded yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>

