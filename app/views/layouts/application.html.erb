<!DOCTYPE html>
<%
  theme_modes = Core::ThemeRegistry.modes_map
  default_theme = Core::ThemeRegistry.default_key
  default_mode = Core::ThemeRegistry.default_mode
%>
<html lang="en" data-theme="<%= default_theme %>" data-mode="<%= default_mode %>">
  <head>
    <title><%= content_for(:title) || "WealthFlow — Private Portfolio & Tax Cockpit" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <style id="wf-theme-tokens">
      <%= raw(Core::ThemeRegistry.css_variables_stylesheet) %>
    </style>

    <script>
      (function () {
        try {
          var modes = <%= raw(theme_modes.to_json) %>;
          var def = <%= raw(default_theme.to_json) %>;
          var t = localStorage.getItem("wf_theme") || def;
          if (!modes[t]) t = def;
          var mode = modes[t] === "light" ? "light" : "dark";
          document.documentElement.dataset.theme = t;
          document.documentElement.dataset.mode = mode;
          document.documentElement.style.colorScheme = mode;
        } catch (_) {}
      })();
    </script>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script src="/javascripts/motion.min.js" data-turbo-track="reload"></script>
    <%= javascript_importmap_tags %>
    <script src="/javascripts/wealthflow_client.js" data-turbo-track="reload" defer></script>

    <% if user_signed_in? && !@session_locked && @data.present? %>
      <script>
        window.TRACKER_DATA = <%= raw(@data.to_json.gsub("</", "<\\/")) %>;
        window.OVERVIEW_DATA = <%= raw(@ov.to_json.gsub("</", "<\\/")) %>;
      </script>
    <% end %>
  </head>

  <body class="bg-slate-950 text-slate-100 min-h-screen antialiased selection:bg-indigo-500/30 selection:text-indigo-200">
    <%
      nav_items = [
        { path: root_path, label: "Overview", badge: "Core" },
        { path: mutual_funds_path, label: "Mutual Funds", badge: "SIP" },
        { path: fixed_income_path, label: "Fixed Income", badge: "FD/RD" },
        { path: retirement_path, label: "PPF & EPF", badge: "Vault" },
        { path: insurance_path, label: "Insurance", badge: "Cover" },
        { path: home_loan_path, label: "Home Loan", badge: "EMI" },
        { path: banking_path, label: "Banking & Cards", badge: "Liquid" },
        { path: tax_calculator_path, label: "Tax Planner", badge: "ITR" }
      ]
      active_item = nav_items.find { |n| n[:path] == "/" ? request.path == "/" : request.path.start_with?(n[:path]) }
      active_page_label = active_item ? active_item[:label] : (devise_controller? ? "Account Security" : "Portfolio Workspace")

      flash_toast_payload = []
      flash.each do |kind, msg|
        next if msg.blank?
        variant = %w[alert error danger].include?(kind.to_s) ? "error" : "success"
        flash_toast_payload << { message: msg.to_s, variant: variant }
      end
    %>

    <!-- Unified Floating Toast Stack (replaces static top banners) -->
    <div
      id="toast-stack"
      data-controller="toast"
      data-toast-messages-value="<%= json_escape(flash_toast_payload.to_json) %>"
      aria-live="polite"
      class="fixed top-20 right-5 z-[90] flex flex-col gap-2.5 items-end pointer-events-none"
    ></div>

    <% if user_signed_in? %>
      <div
        class="wf-app-shell min-h-screen flex bg-slate-950"
        data-controller="sidebar theme"
        data-theme-default-value="<%= default_theme %>"
        data-theme-modes-value="<%= json_escape(theme_modes.to_json) %>"
      >
        <!-- Mobile Sidebar Backdrop -->
        <div
          data-sidebar-target="backdrop"
          data-action="click->sidebar#close"
          class="fixed inset-0 z-40 bg-slate-950/80 backdrop-blur-sm hidden lg:hidden"
        ></div>

        <!-- Left Navigation Sidebar (Module Options + Exports + User Account) -->
        <aside
          data-sidebar-target="drawer"
          aria-label="Primary Sidebar Navigation"
          class="fixed lg:sticky top-0 left-0 z-50 lg:z-30 h-screen w-68 shrink-0 bg-slate-900/95 border-r border-slate-800/90 backdrop-blur-xl flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
        >
          <!-- Brand Logo -->
          <div class="px-4 h-16 border-b border-slate-800/80 flex items-center justify-between gap-2 shrink-0">
            <a href="<%= root_path %>" class="flex items-center gap-2.5 group">
              <div class="wf-brand-icon w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-indigo-500/25">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <div>
                <div class="font-bold text-base tracking-tight text-white group-hover:text-indigo-300 transition-colors">WealthFlow</div>
                <div class="text-[10px] font-mono text-indigo-300/80 uppercase tracking-wider">Wealth Cockpit</div>
              </div>
            </a>

            <button
              type="button"
              data-action="click->sidebar#close"
              class="lg:hidden p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800"
              aria-label="Close Sidebar"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>

          <!-- Sidebar Module Navigation Links -->
          <nav class="flex-1 overflow-y-auto p-3 space-y-1 card-scroll" aria-label="Portfolio Modules">
            <div class="px-2.5 pb-1 text-[10px] font-bold uppercase tracking-wider text-slate-500">Portfolio Modules</div>
            <% nav_items.each do |item| %>
              <% active = (item[:path] == "/") ? (request.path == "/") : request.path.start_with?(item[:path]) %>
              <a
                href="<%= item[:path] %>"
                data-action="click->sidebar#close"
                class="flex items-center justify-between px-3 py-2.5 rounded-xl text-xs font-medium transition-all <%= active ? 'bg-indigo-600/25 text-white border border-indigo-500/40 shadow-sm shadow-indigo-500/10' : 'text-slate-300 hover:text-white hover:bg-slate-800/70 border border-transparent' %>"
              >
                <span><%= item[:label] %></span>
                <span class="px-1.5 py-0.5 rounded text-[10px] font-mono <%= active ? 'bg-indigo-500/30 text-indigo-200' : 'bg-slate-800 text-slate-400' %>"><%= item[:badge] %></span>
              </a>
            <% end %>

            <div class="pt-4 pb-1 px-2.5 text-[10px] font-bold uppercase tracking-wider text-slate-500">Reports &amp; Security</div>
            <a href="/api/export_csv" data-turbo="false" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs text-slate-300 hover:text-white hover:bg-slate-800/70 transition-colors">
              <span>Export Portfolio CSV</span>
              <span class="text-[10px] font-mono text-emerald-400">.csv</span>
            </a>
            <a href="/api/export_excel" data-turbo="false" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs text-slate-300 hover:text-white hover:bg-slate-800/70 transition-colors">
              <span>Export Excel Workbook</span>
              <span class="text-[10px] font-mono text-emerald-400">.xls</span>
            </a>
            <a href="<%= edit_user_registration_path %>" data-action="click->sidebar#close" class="flex items-center justify-between px-3 py-2 rounded-xl text-xs text-slate-300 hover:text-white hover:bg-slate-800/70 transition-colors">
              <span>Account &amp; Password</span>
              <span class="text-[10px] font-mono text-cyan-400">Profile</span>
            </a>
          </nav>

          <!-- Sidebar Footer: User Account, Security PIN & Sign Out -->
          <div class="p-3.5 border-t border-slate-800/80 bg-slate-950/60 space-y-2.5 shrink-0">
            <div class="flex items-center justify-between gap-2">
              <div class="min-w-0">
                <div class="text-xs font-semibold text-white truncate"><%= current_user.name %></div>
                <div class="text-[10px] font-mono text-slate-400 truncate"><%= current_user.email %></div>
              </div>
              <span class="px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-[10px] font-semibold text-emerald-300 shrink-0">Private</span>
            </div>

            <div class="flex items-center gap-1.5">
              <button
                type="button"
                onclick="openSecurityPinModal(<%= @pin_enabled ? 'true' : 'false' %>)"
                class="flex-1 inline-flex items-center justify-center gap-1 px-2.5 py-1.5 rounded-lg text-[11px] font-medium bg-indigo-500/15 hover:bg-indigo-500/25 text-indigo-300 border border-indigo-500/30 transition-colors"
                title="Configure Security PIN"
              >
                <%= @pin_enabled ? "PIN Active" : "Set PIN" %>
              </button>

              <% if @pin_enabled && !@session_locked %>
                <button
                  type="button"
                  onclick="lockCockpitSession()"
                  class="px-2.5 py-1.5 rounded-lg text-[11px] font-medium bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/30 transition-colors"
                  title="Lock Portfolio"
                >Lock</button>
              <% end %>

              <%= button_to "Sign Out", destroy_user_session_path, method: :delete,
                    class: "px-2.5 py-1.5 rounded-lg text-[11px] font-medium bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 border border-rose-500/30 transition-colors cursor-pointer" %>
            </div>
          </div>
        </aside>

        <!-- Main Workspace Column -->
        <div class="flex-1 flex flex-col min-w-0">
          <!-- Top Panel Header: Active Page Title + AI Top-Panel Global Search Omnibar + 3-Theme Switcher (NO module nav links here) -->
          <header class="sticky top-0 z-30 min-h-16 py-2.5 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-xl px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3 min-w-0">
              <button
                type="button"
                data-action="click->sidebar#open"
                class="lg:hidden p-2 rounded-xl bg-slate-900 border border-slate-700 text-slate-300 hover:text-white"
                aria-label="Open Navigation Sidebar"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
              </button>

              <div class="min-w-0">
                <div class="text-sm sm:text-base font-bold text-white truncate"><%= active_page_label %></div>
                <div class="text-[11px] text-slate-400 hidden sm:block truncate">
                  Private Vault • <%= current_user.name %>
                </div>
              </div>
            </div>

            <!-- Top Search Bar (Search -> Page Navigation | Ask AI -> Opens Drawer) -->
            <div
              id="top-portfolio-search"
              data-controller="global-search"
              class="relative w-full md:w-[27rem] xl:w-[32rem] order-3 md:order-2"
            >
              <label for="global-top-search" class="sr-only">Search portfolio or switch to Ask AI mode</label>
              <div class="relative flex items-center gap-1.5 px-2 py-1 rounded-xl bg-slate-900/95 border border-slate-700/80 shadow-sm focus-within:border-indigo-500">
                <div class="flex items-center p-0.5 rounded-lg bg-slate-950 border border-slate-800 shrink-0" role="group" aria-label="Search Mode">
                  <button
                    type="button"
                    data-global-search-target="modeBtn"
                    data-search-mode="search"
                    data-action="click->global-search#setMode"
                    class="px-2 py-1 rounded-md text-[10px] font-semibold bg-indigo-600 text-white transition-colors cursor-pointer"
                  >Search</button>
                  <button
                    type="button"
                    data-global-search-target="modeBtn"
                    data-search-mode="ai"
                    data-action="click->global-search#setMode"
                    class="px-2 py-1 rounded-md text-[10px] font-medium text-slate-400 hover:text-white transition-colors cursor-pointer"
                  >Ask AI</button>
                </div>

                <input
                  id="global-top-search"
                  type="search"
                  autocomplete="off"
                  placeholder="Search FD, MF, PPF, Home Loan, Bank, Insurance, Tax..."
                  data-global-search-target="input"
                  data-action="focus->global-search#onFocus input->global-search#onInput keydown->global-search#onKeydown"
                  class="flex-1 min-w-0 bg-transparent px-1.5 py-1 text-xs text-white placeholder-slate-400 focus:outline-none border-0"
                >

                <span data-global-search-target="spinner" class="hidden w-3.5 h-3.5 rounded-full border-2 border-indigo-400 border-t-transparent animate-spin shrink-0"></span>
                <kbd class="hidden sm:inline-block px-1.5 py-0.5 rounded bg-slate-800 border border-slate-700 text-[10px] font-mono text-slate-400 shrink-0">/</kbd>
              </div>

              <!-- Search Results Dropdown (Takes user directly to matching page or shows "No match found") -->
              <div
                data-global-search-target="panel"
                class="hidden absolute left-0 right-0 top-full mt-2 z-50 rounded-2xl bg-slate-900 border border-slate-700 shadow-2xl overflow-hidden"
              >
                <div class="px-3.5 py-2 border-b border-slate-800 flex items-center justify-between text-[10px] uppercase tracking-wider text-slate-400">
                  <span class="font-semibold text-indigo-300">Jump to Page</span>
                  <span>Press Enter or Click</span>
                </div>
                <div data-global-search-target="list" class="max-h-72 overflow-y-auto p-2 space-y-1 card-scroll"></div>
              </div>
            </div>

            <!-- Right Controls: Dedicated AI Drawer Button + Config-Driven Theme Switcher (theme.yml) -->
            <div class="flex items-center gap-2 order-2 md:order-3 shrink-0">
              <button
                type="button"
                id="open-ai-drawer-btn"
                onclick="openAiAssistantDrawer(document.getElementById('global-top-search')?.value || '')"
                class="wf-cta-solid inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-sm transition-colors cursor-pointer"
                title="Open WealthFlow AI Drawer"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
                </svg>
                <span>Ask AI</span>
              </button>

              <div class="flex items-center gap-1 p-1 rounded-xl bg-slate-900/90 border border-slate-800" role="group" aria-label="Theme Switcher">
                <% Core::ThemeRegistry.all.each do |theme_key, cfg| %>
                  <button
                    type="button"
                    data-theme-target="button"
                    data-theme-value="<%= theme_key %>"
                    data-action="click->theme#select"
                    title="<%= cfg['description'] %>"
                    class="px-2.5 py-1 rounded-lg text-[11px] font-semibold text-slate-300 border border-transparent hover:text-white transition-all cursor-pointer"
                  ><%= cfg["short_label"] || cfg["label"] %></button>
                <% end %>
              </div>
            </div>
          </header>

          <!-- Main Content -->
          <main class="flex-1 w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
            <% if @session_locked %>
              <div id="pin-unlock-screen" class="max-w-md mx-auto mt-16 glass-card rounded-2xl p-6 space-y-4 text-center" data-controller="motion">
                <div class="w-12 h-12 mx-auto rounded-2xl bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-300">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
                  </svg>
                </div>
                <div>
                  <h1 class="text-lg font-bold text-white">WealthFlow Cockpit Locked</h1>
                  <p class="text-xs text-slate-400 mt-1">Enter your security PIN to access your portfolio data.</p>
                </div>
                <form onsubmit="event.preventDefault(); unlockCockpitSession();" class="space-y-3">
                  <input type="password" id="unlock-pin-input" autocomplete="current-password" placeholder="Enter Security PIN" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950/90 border border-slate-700 text-center text-sm font-mono text-white focus:border-indigo-500 focus:outline-none">
                  <button type="submit" class="w-full py-2.5 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-500/25 transition-colors">Unlock Portfolio</button>
                </form>
              </div>
            <% else %>
              <%= yield %>
            <% end %>
          </main>

          <footer class="border-t border-slate-800/70 bg-slate-950/60 mt-auto">
            <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-500">
              <div>WealthFlow • Personal Portfolio, Retirement &amp; Tax Cockpit</div>
              <div>Last Synced: <span class="text-slate-400 font-mono"><%= format_date_dmy(@data&.dig(:user, :last_updated), Date.current.strftime("%d/%m/%Y")) %></span></div>
            </div>
          </footer>
        </div>
      </div>
    <% else %>
      <!-- Signed-Out Auth Shell -->
      <div
        class="wf-app-shell min-h-screen flex flex-col"
        data-controller="theme"
        data-theme-default-value="<%= default_theme %>"
        data-theme-modes-value="<%= json_escape(theme_modes.to_json) %>"
      >
        <header class="sticky top-0 z-30 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-xl">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
            <a href="<%= new_user_session_path %>" class="flex items-center gap-2.5">
              <div class="wf-brand-icon w-8 h-8 rounded-xl bg-gradient-to-br from-indigo-500 to-cyan-400 flex items-center justify-center shadow-lg shadow-indigo-500/25">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                </svg>
              </div>
              <span class="font-bold text-lg tracking-tight text-white">WealthFlow</span>
            </a>

            <div class="flex items-center gap-3">
              <div class="hidden sm:flex items-center gap-1 p-1 rounded-xl bg-slate-900/90 border border-slate-800" role="group" aria-label="Theme Switcher">
                <% Core::ThemeRegistry.all.each do |theme_key, cfg| %>
                  <button
                    type="button"
                    data-theme-target="button"
                    data-theme-value="<%= theme_key %>"
                    data-action="click->theme#select"
                    title="<%= cfg['description'] %>"
                    class="px-2 py-1 rounded-lg text-[10px] font-semibold text-slate-300 border border-transparent hover:text-white cursor-pointer"
                  ><%= cfg["short_label"] || cfg["label"] %></button>
                <% end %>
              </div>

              <div class="flex items-center gap-2">
                <%= link_to "Sign In", new_user_session_path, class: "px-3.5 py-1.5 rounded-xl text-xs font-medium text-slate-200 hover:bg-slate-800 transition-colors" %>
                <%= link_to "Create Account", new_user_registration_path, class: "wf-cta-solid px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white transition-colors" %>
              </div>
            </div>
          </div>
        </header>

        <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-4">
          <%= yield %>
        </main>

        <footer class="border-t border-slate-800/70 py-5 mt-auto">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-500">
            <span>WealthFlow • Private Personal Finance &amp; Wealth Management</span>
            <span>Per-User Isolated Portfolio Vaults</span>
          </div>
        </footer>
      </div>
    <% end %>

    <!-- Unified Slide-Over Right Drawer (Forms, Confirmations, AI Assistant, Inspections — Zero Modals/Popups) -->
    <div id="right-drawer" class="fixed inset-0 z-50 hidden" aria-hidden="true">
      <div id="drawer-backdrop" onclick="closeDrawer()" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm opacity-0"></div>
      <div class="fixed inset-y-0 right-0 flex max-w-full pl-8 sm:pl-10">
        <div id="drawer-panel" class="w-screen max-w-2xl bg-slate-900 border-l border-slate-700/80 shadow-2xl transform translate-x-full flex flex-col will-change-transform">
          <div id="drawer-header" class="px-6 py-4 border-b border-slate-800 flex items-center justify-between shrink-0">
            <div>
              <h3 id="drawer-title" class="text-base font-bold text-white">Workspace</h3>
              <p id="drawer-subtitle" class="text-xs text-slate-400 mt-0.5"></p>
            </div>
            <button type="button" onclick="closeDrawer()" class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors cursor-pointer" aria-label="Close Drawer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
          <div id="drawer-body" class="flex-1 overflow-y-auto p-6 card-scroll"></div>
          <div id="drawer-footer" class="hidden px-6 py-4 border-t border-slate-800 flex items-center justify-end gap-2.5 bg-slate-900/95 shrink-0">
            <button type="button" id="drawer-cancel-btn" onclick="closeDrawer()" class="px-4 py-2 rounded-xl text-xs font-medium bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors cursor-pointer">Cancel</button>
            <button type="button" id="drawer-submit-btn" onclick="submitModalForm()" class="wf-cta-solid px-4 py-2 rounded-xl text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 shadow-lg shadow-indigo-500/25 transition-colors cursor-pointer">Save Changes</button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
